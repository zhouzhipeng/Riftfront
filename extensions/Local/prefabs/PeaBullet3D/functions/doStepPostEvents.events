@event aiGeneratedEventId="pea-bullet-move-forward"
if PosX object="Object" comparison_sign="<=" value=1400
do SetX object="Object" modification_sign="+" value=expr(Variable(Speed) * TimeDelta())

@event aiGeneratedEventId="pea-bullet-delete-offscreen"
if PosX object="Object" comparison_sign=">" value=1400
do Delete object="Object"
