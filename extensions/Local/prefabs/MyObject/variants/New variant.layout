[layout]
version = 1
bounds = { max = [64, 64, 64], min = [0, 0, 0] }

[editor]
grid = false
grid_type = "rectangular"
grid_size = [32, 32, 32]
grid_offset = [0, 0, 0]
grid_color = "#9EB4FF"
grid_alpha = 0.8
snap = false
zoom = 10.9375
window_mask = false
selected_layer = ""
mode = "instances-editor"

[[layers]]
id = "base"
name = ""
cameras = [{ size = "default", viewport = "default" }]
