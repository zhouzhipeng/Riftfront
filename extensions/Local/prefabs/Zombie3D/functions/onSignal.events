@event aiGeneratedEventId="zombie-handle-attack-signal"
if BuiltinCommonInstructions::CompareStrings first_string_expression=expr(SignalName) comparison_sign="=" second_string_expression="Zombie.Attack"
if AnimatableCapability::AnimatableBehavior::Index object="ZombieModel" behavior="Animation" comparison_sign="!=" animation_index=1
do AnimatableCapability::AnimatableBehavior::SetIndex object="ZombieModel" behavior="Animation" modification_sign="=" animation_index=1
do AnimatableCapability::AnimatableBehavior::SetElapsedTime object="ZombieModel" behavior="Animation" modification_sign="=" elapsed_time_in_seconds=0
do AnimatableCapability::AnimatableBehavior::PlayAnimation object="ZombieModel" behavior="Animation"

@event aiGeneratedEventId="zombie-handle-walk-signal"
if BuiltinCommonInstructions::CompareStrings first_string_expression=expr(SignalName) comparison_sign="=" second_string_expression="Zombie.Walk"
if AnimatableCapability::AnimatableBehavior::Index object="ZombieModel" behavior="Animation" comparison_sign="!=" animation_index=0
do AnimatableCapability::AnimatableBehavior::SetIndex object="ZombieModel" behavior="Animation" modification_sign="=" animation_index=0
do AnimatableCapability::AnimatableBehavior::SetElapsedTime object="ZombieModel" behavior="Animation" modification_sign="=" elapsed_time_in_seconds=0
do AnimatableCapability::AnimatableBehavior::PlayAnimation object="ZombieModel" behavior="Animation"

@event aiGeneratedEventId="zombie-handle-damage-signal"
if BuiltinCommonInstructions::CompareStrings first_string_expression=expr(SignalName) comparison_sign="=" second_string_expression="Unit.Damage"
if VarObjet object="Object" variable="HP" comparison_sign=">" value=0
do ModVarObjet object="Object" variable="HP" modification_sign="=" value=expr(max(0, Object.Variable(HP) - max(0, ToNumber(Payload))))

@event aiGeneratedEventId="zombie-update-health-bar-after-damage"
if BuiltinCommonInstructions::CompareStrings first_string_expression=expr(SignalName) comparison_sign="=" second_string_expression="Unit.Damage"
if VarObjet object="Object" variable="HP" comparison_sign=">" value=0
do EmitSignalToObjectInstance instance_id=expr(HealthBar.InstanceId()) signal_name="HealthBar.SetRatio" payload=expr(ToString(Object.Variable(HP) / Object.Variable(MaxHP)))

@event aiGeneratedEventId="zombie-health-bar-camera-x"
if BuiltinCommonInstructions::CompareStrings first_string_expression=expr(SignalName) comparison_sign="=" second_string_expression="HealthBar.FaceCameraX"
do Scene3D::Base3DBehavior::SetRotationX parameter_3d_object="HealthBar" behavior="Base3D" modification_sign="=" angle_in_degrees=expr(ToNumber(Payload))

@event aiGeneratedEventId="zombie-health-bar-camera-y"
if BuiltinCommonInstructions::CompareStrings first_string_expression=expr(SignalName) comparison_sign="=" second_string_expression="HealthBar.FaceCameraY"
do Scene3D::Base3DBehavior::SetRotationY parameter_3d_object="HealthBar" behavior="Base3D" modification_sign="=" angle_in_degrees=expr(ToNumber(Payload))

@event aiGeneratedEventId="zombie-health-bar-camera-z"
if BuiltinCommonInstructions::CompareStrings first_string_expression=expr(SignalName) comparison_sign="=" second_string_expression="HealthBar.FaceCameraZ"
do SetAngle object="HealthBar" modification_sign="=" angle_in_degrees=expr(ToNumber(Payload))
