@event aiGeneratedEventId="peashooter-handle-damage-signal"
if BuiltinCommonInstructions::CompareStrings first_string_expression=expr(SignalName) comparison_sign="=" second_string_expression="Unit.Damage"
if NumberVariable variable="HP" comparison_sign=">" value=0
do SetNumberVariable variable="HP" modification_sign="=" value=expr(max(0, Variable(HP) - max(0, ToNumber(Payload))))

@event aiGeneratedEventId="peashooter-update-health-bar-after-damage"
if BuiltinCommonInstructions::CompareStrings first_string_expression=expr(SignalName) comparison_sign="=" second_string_expression="Unit.Damage"
if NumberVariable variable="HP" comparison_sign=">" value=0
do EmitSignalToObjectInstance instance_id=expr(HealthBar.InstanceId()) signal_name="HealthBar.SetRatio" payload=expr(ToString(Variable(HP) / Variable(MaxHP)))

@event aiGeneratedEventId="peashooter-fire-confirmed"
if BuiltinCommonInstructions::CompareStrings first_string_expression=expr(SignalName) comparison_sign="=" second_string_expression="Peashooter.FireConfirmed"
do AnimatableCapability::AnimatableBehavior::SetIndex object="PeashooterModel" behavior="Animation" modification_sign="=" animation_index=1
do AnimatableCapability::AnimatableBehavior::SetElapsedTime object="PeashooterModel" behavior="Animation" modification_sign="=" elapsed_time_in_seconds=0
do AnimatableCapability::AnimatableBehavior::PlayAnimation object="PeashooterModel" behavior="Animation"
do PlaySound audio_file_or_audio_resource_name="PVZ_PlantAttack" repeat_the_sound=false volume=42 pitch_speed=1
