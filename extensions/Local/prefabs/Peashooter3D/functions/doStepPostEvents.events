@event aiGeneratedEventId="peashooter-emit-spawn-bullet"
if CompareObjectTimer object="Object" timer_name="FireCooldown" comparison_sign=">=" time_in_seconds=1.1
do EmitSceneSignal signal_name="Peashooter.SpawnBullet" payload=expr(ToString(Object.InstanceId()))
do ResetObjectTimer object="Object" timer_name="FireCooldown"

@event aiGeneratedEventId="peashooter-return-to-idle"
if AnimatableCapability::AnimatableBehavior::Index object="PeashooterModel" behavior="Animation" comparison_sign="=" animation_index=1
if AnimatableCapability::AnimatableBehavior::HasAnimationEnded object="PeashooterModel" behavior="Animation"
do AnimatableCapability::AnimatableBehavior::SetIndex object="PeashooterModel" behavior="Animation" modification_sign="=" animation_index=0
do AnimatableCapability::AnimatableBehavior::SetElapsedTime object="PeashooterModel" behavior="Animation" modification_sign="=" elapsed_time_in_seconds=0
do AnimatableCapability::AnimatableBehavior::PlayAnimation object="PeashooterModel" behavior="Animation"

@event aiGeneratedEventId="peashooter-delete-at-zero-health"
if NumberVariable variable="HP" comparison_sign="<=" value=0
do Delete object="Object"
