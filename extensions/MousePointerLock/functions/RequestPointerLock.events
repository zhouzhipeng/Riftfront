@event
if HasAnyTouchOrMouseStarted
if NumberVariable variable="TouchId" comparison_sign="=" value=-1
do SetNumberVariable variable="TouchId" modification_sign="=" value=expr(StartedTouchOrMouseId(0))
do SetNumberVariable variable="OldX" modification_sign="=" value=expr(MousePointerLock::TouchX(TouchId))
do SetNumberVariable variable="OldY" modification_sign="=" value=expr(MousePointerLock::TouchY(TouchId))

@js strict=true expanded=false
const { handler } = gdjs._MousePointerLockExtension;

handler.requestPointerLock();

@end js
