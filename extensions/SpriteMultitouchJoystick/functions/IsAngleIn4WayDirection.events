@event
if BuiltinCommonInstructions::CompareStrings first_string_expression=expr(Direction) comparison_sign="=" second_string_expression="Right"
if SpriteMultitouchJoystick::AngleTo4Way comparison_sign="=" value=0 angle=expr(Angle)
do SetReturnBoolean should_the_condition_be_true_or_false=true

@event
if BuiltinCommonInstructions::CompareStrings first_string_expression=expr(Direction) comparison_sign="=" second_string_expression="Down"
if SpriteMultitouchJoystick::AngleTo4Way comparison_sign="=" value=1 angle=expr(Angle)
do SetReturnBoolean should_the_condition_be_true_or_false=true

@event
if BuiltinCommonInstructions::CompareStrings first_string_expression=expr(Direction) comparison_sign="=" second_string_expression="Left"
if SpriteMultitouchJoystick::AngleTo4Way comparison_sign="=" value=2 angle=expr(Angle)
do SetReturnBoolean should_the_condition_be_true_or_false=true

@event
if BuiltinCommonInstructions::CompareStrings first_string_expression=expr(Direction) comparison_sign="=" second_string_expression="Up"
if SpriteMultitouchJoystick::AngleTo4Way comparison_sign="=" value=3 angle=expr(Angle)
do SetReturnBoolean should_the_condition_be_true_or_false=true
