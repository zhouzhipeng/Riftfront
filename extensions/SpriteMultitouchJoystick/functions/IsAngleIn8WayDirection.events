@event
if BuiltinCommonInstructions::CompareStrings first_string_expression=expr(Direction) comparison_sign="=" second_string_expression="Right"
if SpriteMultitouchJoystick::AngleTo8Way comparison_sign="=" value=0 angle=expr(Angle)
do SetReturnBoolean should_the_condition_be_true_or_false=true

