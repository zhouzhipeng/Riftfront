@event
local Cos = var(type="number",value=0,persistentUuid="",folded=true,hasMixedValues=false)
local Sin = var(type="number",value=0,persistentUuid="",folded=true,hasMixedValues=false)
do SetNumberVariable variable="Cos" modification_sign="=" value=expr(cos(ToRad(RotationAngle)))
do SetNumberVariable variable="Sin" modification_sign="=" value=expr(sin(ToRad(RotationAngle)))
do SetReturnNumber the_number_to_be_returned=expr(Cos * X - Sin * Y)
