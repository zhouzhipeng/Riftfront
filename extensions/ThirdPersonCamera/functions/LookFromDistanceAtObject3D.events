@event
do ThirdPersonCamera::LookFromDistanceAtPosition3D position_on_x_axis=expr(Object.CenterX()) position_on_y_axis=expr(Object.CenterY()) position_on_z_axis=expr(Object.Object3D::CenterZ()) distance=expr(Distance) rotation_angle_around_z_axis=expr(RotationAngle) elevation_angle_around_y_axis=expr(ElevationAngle) layer=expr(Layer)
