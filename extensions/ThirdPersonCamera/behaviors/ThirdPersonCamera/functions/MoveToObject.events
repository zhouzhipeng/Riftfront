@event
do SetCameraCenterX modification_sign="=" value=expr(Object.CenterX() + LocalOffsetX * Object.Object3D::ForwardX() + LocalOffsetY * Object.Object3D::RightX() + LocalOffsetZ * Object.Object3D::UpX()) layer=expr(Object.Layer())
do SetCameraCenterY modification_sign="=" value=expr(Object.CenterY() + LocalOffsetX * Object.Object3D::ForwardY() + LocalOffsetY * Object.Object3D::RightY() + LocalOffsetZ * Object.Object3D::UpY()) layer=expr(Object.Layer())
do Scene3D::SetCameraZ modification_sign="=" value=expr(Object.Object3D::CenterZ() + LocalOffsetX * Object.Object3D::ForwardZ() + LocalOffsetY * Object.Object3D::RightZ() + LocalOffsetZ * Object.Object3D::UpZ()) layer=expr(Object.Layer())
