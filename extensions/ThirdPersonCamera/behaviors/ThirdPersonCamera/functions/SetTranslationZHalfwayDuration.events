@comment "ln((1 - speed)) = ln(1 / 2) / halfwatTime" background=[255,230,109] text=[0,0,0]

@event
do SetNumberVariable variable="TranslationZHalfwayDuration" modification_sign="=" value=expr(Value)
do SetNumberVariable variable="TranslationZLogSpeed" modification_sign="=" value=expr(log(0.5) / Value)
