@event
do ThirdPersonCamera::LookFromDistanceAtPosition3D position_on_x_axis=expr(Object.CenterX() + ThirdPersonCamera::RotatedX(Value, OffsetX, -OffsetY)) position_on_y_axis=expr(Object.CenterY() + ThirdPersonCamera::RotatedY(Value, OffsetX, -OffsetY)) position_on_z_axis=expr(CameraZ + OffsetZ) distance=expr(Distance) rotation_angle_around_z_axis=expr(Value) elevation_angle_around_y_axis=expr(Object.Object3D::RotationY() + ElevationAngleOffset)
