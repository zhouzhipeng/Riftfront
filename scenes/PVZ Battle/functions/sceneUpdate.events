> do SetY object="SelectedSunflower" modification_sign="=" value=expr((Variable(CameraTargetY) + Variable(CameraDistance) * sin(ToRad(Variable(CameraOrbitAngle) + 90)) * cos(ToRad(Variable(CameraElevationAngle)))) + (Raycaster3D::IntersectionY() - (Variable(CameraTargetY) + Variable(CameraDistance) * sin(ToRad(Variable(CameraOrbitAngle) + 90)) * cos(ToRad(Variable(CameraElevationAngle))))) * 30 / Raycaster3D::Distance())
> do Scene3D::Base3DBehavior::SetZ parameter_3d_object="SelectedSunflower" behavior="Base3D" modification_sign="=" value=expr((Variable(CameraTargetZ) + Variable(CameraDistance) * sin(ToRad(Variable(CameraElevationAngle)))) + (Raycaster3D::IntersectionZ() - (Variable(CameraTargetZ) + Variable(CameraDistance) * sin(ToRad(Variable(CameraElevationAngle))))) * 30 / Raycaster3D::Distance())
