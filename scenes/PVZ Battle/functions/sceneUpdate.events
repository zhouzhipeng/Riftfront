@group "Free orbit camera" source="" creationTime=0 color=[143,108,255] parameters=[]
@event aiGeneratedEventId="pvz-camera-drag-start"
if MouseButtonFromTextPressed button_to_check="Right"
if BuiltinCommonInstructions::Once
do SetNumberVariable variable="CameraDragStartX" modification_sign="=" value=expr(CursorX("HUD", 0))
do SetNumberVariable variable="CameraDragStartY" modification_sign="=" value=expr(CursorY("HUD", 0))
do SetNumberVariable variable="CameraDragStartAngle" modification_sign="=" value=expr(Variable(CameraOrbitAngle))
do SetNumberVariable variable="CameraDragStartElevation" modification_sign="=" value=expr(Variable(CameraElevationAngle))

@event aiGeneratedEventId="pvz-camera-drag-orbit"
if MouseButtonFromTextPressed button_to_check="Right"
do SetNumberVariable variable="CameraOrbitAngle" modification_sign="=" value=expr(Variable(CameraDragStartAngle) + (CursorX("HUD", 0) - Variable(CameraDragStartX)) * 0.35)
do SetNumberVariable variable="CameraElevationAngle" modification_sign="=" value=expr(clamp(Variable(CameraDragStartElevation) + (CursorY("HUD", 0) - Variable(CameraDragStartY)) * 0.25, 20, 78))
do ThirdPersonCamera::LookFromDistanceAtPosition3D position_on_x_axis=expr(Variable(CameraTargetX)) position_on_y_axis=expr(Variable(CameraTargetY)) position_on_z_axis=expr(Variable(CameraTargetZ)) distance=expr(Variable(CameraDistance)) rotation_angle_around_z_axis=expr(Variable(CameraOrbitAngle)) elevation_angle_around_y_axis=expr(Variable(CameraElevationAngle)) layer=""

@event aiGeneratedEventId="pvz-camera-pan-start"
if MouseButtonFromTextPressed button_to_check="Middle"
if BuiltinCommonInstructions::Once
do SetNumberVariable variable="CameraPanLastX" modification_sign="=" value=expr(CursorX("HUD", 0))
do SetNumberVariable variable="CameraPanLastY" modification_sign="=" value=expr(CursorY("HUD", 0))

@event aiGeneratedEventId="pvz-camera-pan"
if MouseButtonFromTextPressed button_to_check="Middle"
do SetNumberVariable variable="CameraTargetX" modification_sign="-" value=expr((cos(ToRad(Variable(CameraOrbitAngle))) * (CursorX("HUD", 0) - Variable(CameraPanLastX)) + cos(ToRad(Variable(CameraOrbitAngle) + 90)) * (CursorY("HUD", 0) - Variable(CameraPanLastY))) * Variable(CameraDistance) / 700)
do SetNumberVariable variable="CameraTargetY" modification_sign="-" value=expr((sin(ToRad(Variable(CameraOrbitAngle))) * (CursorX("HUD", 0) - Variable(CameraPanLastX)) + sin(ToRad(Variable(CameraOrbitAngle) + 90)) * (CursorY("HUD", 0) - Variable(CameraPanLastY))) * Variable(CameraDistance) / 700)
do SetNumberVariable variable="CameraPanLastX" modification_sign="=" value=expr(CursorX("HUD", 0))
do SetNumberVariable variable="CameraPanLastY" modification_sign="=" value=expr(CursorY("HUD", 0))
do ThirdPersonCamera::LookFromDistanceAtPosition3D position_on_x_axis=expr(Variable(CameraTargetX)) position_on_y_axis=expr(Variable(CameraTargetY)) position_on_z_axis=expr(Variable(CameraTargetZ)) distance=expr(Variable(CameraDistance)) rotation_angle_around_z_axis=expr(Variable(CameraOrbitAngle)) elevation_angle_around_y_axis=expr(Variable(CameraElevationAngle)) layer=""

@event aiGeneratedEventId="pvz-camera-zoom-in"
if IsMouseWheelScrollingUp
do SetNumberVariable variable="CameraDistance" modification_sign="=" value=expr(max(300, Variable(CameraDistance) * 0.88))
do ThirdPersonCamera::LookFromDistanceAtPosition3D position_on_x_axis=expr(Variable(CameraTargetX)) position_on_y_axis=expr(Variable(CameraTargetY)) position_on_z_axis=expr(Variable(CameraTargetZ)) distance=expr(Variable(CameraDistance)) rotation_angle_around_z_axis=expr(Variable(CameraOrbitAngle)) elevation_angle_around_y_axis=expr(Variable(CameraElevationAngle)) layer=""

@event aiGeneratedEventId="pvz-camera-zoom-out"
if IsMouseWheelScrollingDown
do SetNumberVariable variable="CameraDistance" modification_sign="=" value=expr(min(1800, Variable(CameraDistance) / 0.88))
do ThirdPersonCamera::LookFromDistanceAtPosition3D position_on_x_axis=expr(Variable(CameraTargetX)) position_on_y_axis=expr(Variable(CameraTargetY)) position_on_z_axis=expr(Variable(CameraTargetZ)) distance=expr(Variable(CameraDistance)) rotation_angle_around_z_axis=expr(Variable(CameraOrbitAngle)) elevation_angle_around_y_axis=expr(Variable(CameraElevationAngle)) layer=""
@end group

@group "Plant placement preview" source="" creationTime=0 color=[103,208,93] parameters=[]
@event aiGeneratedEventId="pvz-reset-hover-target"
if BooleanVariable variable="PlantingMode" check_if_the_value_is=true
do Hide object="PlacementHover"
do Hide object="SelectedSunflower"
do Hide object="SelectedPeashooter"
do SetBooleanVariable variable="HasPlacementTarget" modification_sign="False"

@event aiGeneratedEventId="pvz-hover-open-lawn-tile"
if BooleanVariable variable="PlantingMode" check_if_the_value_is=true
if Raycaster3D::RaycastFromCameraCursor objects_to_test_against_the_ray="LawnTiles" parameter_2d_layer="HUD" ray_maximum_distance_in_pixels=5000
if BooleanObjectVariable object="LawnTiles" variable="Occupied" check_if_the_value_is=false
do Show object="PlacementHover"
do SetX object="PlacementHover" modification_sign="=" value=expr(LawnTiles.X() + 6)
do SetY object="PlacementHover" modification_sign="=" value=expr(LawnTiles.Y() + 6)
do Scene3D::Base3DBehavior::SetZ parameter_3d_object="PlacementHover" behavior="Base3D" modification_sign="=" value=5
do SetBooleanVariable variable="HasPlacementTarget" modification_sign="True"

> @event aiGeneratedEventId="pvz-cursor-preview-sunflower"
> if StringVariable variable="SelectedPlantType" comparison_sign="=" value="Sunflower"
> do Show object="SelectedSunflower"
> do SetX object="SelectedSunflower" modification_sign="=" value=expr(Raycaster3D::IntersectionX())
> do SetY object="SelectedSunflower" modification_sign="=" value=expr(Raycaster3D::IntersectionY())
> do Scene3D::Base3DBehavior::SetZ parameter_3d_object="SelectedSunflower" behavior="Base3D" modification_sign="=" value=expr(Raycaster3D::IntersectionZ() + 5)

> @event aiGeneratedEventId="pvz-cursor-preview-peashooter"
> if StringVariable variable="SelectedPlantType" comparison_sign="=" value="Peashooter"
> do Show object="SelectedPeashooter"
> do SetX object="SelectedPeashooter" modification_sign="=" value=expr(Raycaster3D::IntersectionX())
> do SetY object="SelectedPeashooter" modification_sign="=" value=expr(Raycaster3D::IntersectionY())
> do Scene3D::Base3DBehavior::SetZ parameter_3d_object="SelectedPeashooter" behavior="Base3D" modification_sign="=" value=expr(Raycaster3D::IntersectionZ() + 5)
@end group

@group "Plant sunflower" source="" creationTime=0 color=[255,197,72] parameters=[]
@comment "Resolve the clicked tile again so the raycast-picked LawnTiles group remains scoped to this placement event." background=[255,230,109] text=[0,0,0]

@event aiGeneratedEventId="pvz-place-sunflower"
if BooleanVariable variable="PlantingMode" check_if_the_value_is=true
if BooleanVariable variable="HasPlacementTarget" check_if_the_value_is=true
if StringVariable variable="SelectedPlantType" comparison_sign="=" value="Sunflower"
if MouseButtonFromTextReleased button_to_check="Left"
if Raycaster3D::RaycastFromCameraCursor objects_to_test_against_the_ray="LawnTiles" parameter_2d_layer="HUD" ray_maximum_distance_in_pixels=5000
if BooleanObjectVariable object="LawnTiles" variable="Occupied" check_if_the_value_is=false
do SetBooleanObjectVariable object="LawnTiles" variable="Occupied" modification_sign="True"
do Create object_to_create="SunflowerPlant" x_position=expr(LawnTiles.X() + 50) y_position=expr(LawnTiles.Y() + 50) layer=""
do Scene3D::Base3DBehavior::SetZ parameter_3d_object="SunflowerPlant" behavior="Base3D" modification_sign="=" value=5
do SetNumberVariable variable="PlacedPlants" modification_sign="+" value=1
do SetBooleanVariable variable="PlantingMode" modification_sign="False"
do SetBooleanVariable variable="HasPlacementTarget" modification_sign="False"
do SetStringVariable variable="SelectedPlantType" modification_sign="=" value=""
do Hide object="SelectedSunflower"
do Hide object="SelectedPeashooter"
do Hide object="PlacementHover"
do Hide object="PlantingHint"

@event aiGeneratedEventId="pvz-place-peashooter"
if BooleanVariable variable="PlantingMode" check_if_the_value_is=true
if BooleanVariable variable="HasPlacementTarget" check_if_the_value_is=true
if StringVariable variable="SelectedPlantType" comparison_sign="=" value="Peashooter"
if MouseButtonFromTextReleased button_to_check="Left"
if Raycaster3D::RaycastFromCameraCursor objects_to_test_against_the_ray="LawnTiles" parameter_2d_layer="HUD" ray_maximum_distance_in_pixels=5000
if BooleanObjectVariable object="LawnTiles" variable="Occupied" check_if_the_value_is=false
do SetBooleanObjectVariable object="LawnTiles" variable="Occupied" modification_sign="True"
do Create object_to_create="PeashooterPlant" x_position=expr(LawnTiles.X() + 50) y_position=expr(LawnTiles.Y() + 50) layer=""
do Scene3D::Base3DBehavior::SetZ parameter_3d_object="PeashooterPlant" behavior="Base3D" modification_sign="=" value=5
do SetNumberVariable variable="PlacedPlants" modification_sign="+" value=1
do SetBooleanVariable variable="PlantingMode" modification_sign="False"
do SetBooleanVariable variable="HasPlacementTarget" modification_sign="False"
do SetStringVariable variable="SelectedPlantType" modification_sign="=" value=""
do Hide object="SelectedSunflower"
do Hide object="SelectedPeashooter"
do Hide object="PlacementHover"
do Hide object="PlantingHint"

@event aiGeneratedEventId="pvz-cancel-planting"
if BooleanVariable variable="PlantingMode" check_if_the_value_is=true
if KeyFromTextReleased key_to_check="Escape"
do SetBooleanVariable variable="PlantingMode" modification_sign="False"
do SetBooleanVariable variable="HasPlacementTarget" modification_sign="False"
do SetStringVariable variable="SelectedPlantType" modification_sign="=" value=""
do Hide object="SelectedSunflower"
do Hide object="SelectedPeashooter"
do Hide object="PlacementHover"
do Hide object="PlantingHint"
@end group

@group "Choose plant" source="" creationTime=0 color=[247,217,83] parameters=[]
@comment "Selection is intentionally after placement so the card click cannot also plant on the same frame." background=[255,230,109] text=[0,0,0]

@event aiGeneratedEventId="pvz-select-sunflower"
if IsCursorOnObject object="SunflowerCard" accurate_test_yes_by_default=true
if MouseButtonFromTextReleased button_to_check="Left"
do SetBooleanVariable variable="PlantingMode" modification_sign="True"
do SetBooleanVariable variable="HasPlacementTarget" modification_sign="False"
do SetStringVariable variable="SelectedPlantType" modification_sign="=" value="Sunflower"
do Show object="SelectedSunflower"
do Hide object="SelectedPeashooter"
do Show object="PlantingHint"

@event aiGeneratedEventId="pvz-select-peashooter"
if IsCursorOnObject object="PeashooterCard" accurate_test_yes_by_default=true
if MouseButtonFromTextReleased button_to_check="Left"
do SetBooleanVariable variable="PlantingMode" modification_sign="True"
do SetBooleanVariable variable="HasPlacementTarget" modification_sign="False"
do SetStringVariable variable="SelectedPlantType" modification_sign="=" value="Peashooter"
do Hide object="SelectedSunflower"
do Show object="SelectedPeashooter"
do Show object="PlantingHint"
@end group

@group "Zombie spawning and lane movement" source="" creationTime=0 color=[150,105,84] parameters=[]
@event aiGeneratedEventId="pvz-spawn-random-zombie"
if CompareTimer timer_name="ZombieSpawn" comparison_sign=">=" time_in_seconds=5
if PickRandomInstance object="ZombieSpawnPoint"
do Create object_to_create="Zombie" x_position=expr(ZombieSpawnPoint.X()) y_position=expr(ZombieSpawnPoint.Y()) layer=""
do Scene3D::Base3DBehavior::SetZ parameter_3d_object="Zombie" behavior="Base3D" modification_sign="=" value=5
do ResetTimer timer_name="ZombieSpawn"

@event aiGeneratedEventId="pvz-zombie-walk-left"
if SceneInstancesCount object="Zombie" comparison_sign=">" value=0
do SetX object="Zombie" modification_sign="=" value=expr(Zombie.X() - 22 * TimeDelta())

@event aiGeneratedEventId="pvz-remove-zombie-at-house"
if PosX object="Zombie" comparison_sign="<" value=180
do Delete object="Zombie"
@end group

@group "Peashooter combat" source="" creationTime=0 color=[84,190,102] parameters=[]
@event aiGeneratedEventId="pvz-each-peashooter-fire"
for each "PeashooterPlant"
> @event aiGeneratedEventId="pvz-peashooter-fire-ready"
> if CompareTimer timer_name="PeashooterFire" comparison_sign=">=" time_in_seconds=1.1
> do EmitSignalToObjectInstance instance_id=expr(PeashooterPlant.InstanceId()) signal_name="Peashooter.Shoot" payload=""
> do Create object_to_create="PeaProjectile" x_position=expr(PeashooterPlant.X() + 45) y_position=expr(PeashooterPlant.Y()) layer=""
> do Scene3D::Base3DBehavior::SetZ parameter_3d_object="PeaProjectile" behavior="Base3D" modification_sign="=" value=52

@event aiGeneratedEventId="pvz-reset-peashooter-fire-timer"
if CompareTimer timer_name="PeashooterFire" comparison_sign=">=" time_in_seconds=1.1
do ResetTimer timer_name="PeashooterFire"

@event aiGeneratedEventId="pvz-move-peas-right"
if SceneInstancesCount object="PeaProjectile" comparison_sign=">" value=0
do SetX object="PeaProjectile" modification_sign="=" value=expr(PeaProjectile.X() + 300 * TimeDelta())

@event aiGeneratedEventId="pvz-each-pea-hit"
for each "PeaProjectile"
> @event aiGeneratedEventId="pvz-pea-hits-zombie"
> if CollisionNP first_object="PeaProjectile" second_object="Zombie" ignore_objects_that_are_touching_each_other_on_their_edges_but_are_not_overlapping_default_no=false
> do SetNumberObjectVariable object="Zombie" variable="HP" modification_sign="-" value=1
> do Delete object="PeaProjectile"

@event aiGeneratedEventId="pvz-remove-defeated-zombie"
if NumberObjectVariable object="Zombie" variable="HP" comparison_sign="<=" value=0
do Delete object="Zombie"

@event aiGeneratedEventId="pvz-remove-offscreen-pea"
if PosX object="PeaProjectile" comparison_sign=">" value=1400
do Delete object="PeaProjectile"
@end group
