@group "Plant sunflower" source="" creationTime=0 color=[255,197,72] parameters=[]
@comment "Resolve the clicked tile again so the raycast-picked LawnTiles group remains scoped to this placement event." background=[255,230,109] text=[0,0,0]

@event aiGeneratedEventId="pvz-place-sunflower"
if BooleanVariable variable="PlantingMode" check_if_the_value_is=true
if BooleanVariable variable="HasPlacementTarget" check_if_the_value_is=true
if StringVariable variable="SelectedPlantType" comparison_sign="=" value="Sunflower"
if MouseButtonFromTextReleased button_to_check="Left"
if BooleanVariable variable="SunCollectedThisFrame" check_if_the_value_is=false
if NumberVariable variable="SunAmount" comparison_sign=">=" value=50
if Raycaster3D::RaycastFromCameraCursor objects_to_test_against_the_ray="LawnTiles" parameter_2d_layer="HUD" ray_maximum_distance_in_pixels=5000
if BooleanObjectVariable object="LawnTiles" variable="Occupied" check_if_the_value_is=false
do SetBooleanObjectVariable object="LawnTiles" variable="Occupied" modification_sign="True"
do Create object_to_create="SunflowerPlant" x_position=expr(LawnTiles.X() + 50) y_position=expr(LawnTiles.Y() + 50) layer=""
do Scene3D::Base3DBehavior::SetZ parameter_3d_object="SunflowerPlant" behavior="Base3D" modification_sign="=" value=5
do PlaySound audio_file_or_audio_resource_name="PVZ_PlacePlant" repeat_the_sound=false volume=65 pitch_speed=1
do SetNumberVariable variable="PlacedPlants" modification_sign="+" value=1
do SetNumberVariable variable="SunAmount" modification_sign="-" value=50
do TextContainerCapability::TextContainerBehavior::SetValue object="SunCounter" behavior="Text" modification_sign="=" text=expr("SUN  " + ToString(Variable(SunAmount)))
do SetBooleanVariable variable="PlantingMode" modification_sign="False"
do SetBooleanVariable variable="HasPlacementTarget" modification_sign="False"
do SetStringVariable variable="SelectedPlantType" modification_sign="=" value=""
do Hide object="SelectedSunflower"
do Hide object="SelectedPeashooter"
do Hide object="PlacementHover"
do Hide object="PlantingHint"

@event aiGeneratedEventId="pvz-place-peashooter"
if BooleanVariable variable="PlantingMode" check_if_the_value_is=true
if BooleanVariable variable="HasPlacementTarget" check_if_the_value_is=true
if StringVariable variable="SelectedPlantType" comparison_sign="=" value="Peashooter"
if MouseButtonFromTextReleased button_to_check="Left"
if BooleanVariable variable="SunCollectedThisFrame" check_if_the_value_is=false
if NumberVariable variable="SunAmount" comparison_sign=">=" value=100
if Raycaster3D::RaycastFromCameraCursor objects_to_test_against_the_ray="LawnTiles" parameter_2d_layer="HUD" ray_maximum_distance_in_pixels=5000
if BooleanObjectVariable object="LawnTiles" variable="Occupied" check_if_the_value_is=false
do SetBooleanObjectVariable object="LawnTiles" variable="Occupied" modification_sign="True"
do Create object_to_create="PeashooterPlant" x_position=expr(LawnTiles.X() + 50) y_position=expr(LawnTiles.Y() + 50) layer=""
do Scene3D::Base3DBehavior::SetZ parameter_3d_object="PeashooterPlant" behavior="Base3D" modification_sign="=" value=5
do PlaySound audio_file_or_audio_resource_name="PVZ_PlacePlant" repeat_the_sound=false volume=65 pitch_speed=1
do SetNumberVariable variable="PlacedPlants" modification_sign="+" value=1
do SetNumberVariable variable="SunAmount" modification_sign="-" value=100
do TextContainerCapability::TextContainerBehavior::SetValue object="SunCounter" behavior="Text" modification_sign="=" text=expr("SUN  " + ToString(Variable(SunAmount)))
do SetBooleanVariable variable="PlantingMode" modification_sign="False"
do SetBooleanVariable variable="HasPlacementTarget" modification_sign="False"
do SetStringVariable variable="SelectedPlantType" modification_sign="=" value=""
do Hide object="SelectedSunflower"
do Hide object="SelectedPeashooter"
do Hide object="PlacementHover"
do Hide object="PlantingHint"

@event aiGeneratedEventId="pvz-cancel-planting"
if BooleanVariable variable="PlantingMode" check_if_the_value_is=true
if KeyFromTextReleased key_to_check="Escape"
do SetBooleanVariable variable="PlantingMode" modification_sign="False"
do SetBooleanVariable variable="HasPlacementTarget" modification_sign="False"
do SetStringVariable variable="SelectedPlantType" modification_sign="=" value=""
do Hide object="SelectedSunflower"
do Hide object="SelectedPeashooter"
do Hide object="PlacementHover"
do Hide object="PlantingHint"
@end group

@group "Shovel tool" source="" creationTime=0 color=[143,108,255] parameters=[]
@comment "The shovel uses the existing HUD icon as its cursor. Removing a plant also releases the lawn tile so it can be replanted." background=[255,230,109] text=[0,0,0]

@event aiGeneratedEventId="pvz-shovel-follow-cursor"
if BooleanObjectVariable object="ShovelSlot" variable="Active" check_if_the_value_is=true
do SetX object="ShovelIcon" modification_sign="=" value=expr(CursorX("HUD", 0) - 76)
do SetY object="ShovelIcon" modification_sign="=" value=expr(CursorY("HUD", 0) - 34)

@event aiGeneratedEventId="pvz-shovel-remove-plant"
if BooleanObjectVariable object="ShovelSlot" variable="Active" check_if_the_value_is=true
if MouseButtonFromTextReleased button_to_check="Left"
if BooleanVariable variable="SunCollectedThisFrame" check_if_the_value_is=false
@instruction inverted=true
if IsCursorOnObject object="ShovelSlot" accurate_test_yes_by_default=true
@instruction inverted=true
if IsCursorOnObject object="SunflowerCard" accurate_test_yes_by_default=true
@instruction inverted=true
if IsCursorOnObject object="PeashooterCard" accurate_test_yes_by_default=true
if Raycaster3D::RaycastFromCameraCursor objects_to_test_against_the_ray="Plants" parameter_2d_layer="HUD" ray_maximum_distance_in_pixels=5000
if PickNearest object="LawnTiles" x_position=expr(Plants.X() - 50) y_position=expr(Plants.Y() - 50)
do SetBooleanObjectVariable object="LawnTiles" variable="Occupied" modification_sign="False"
do Delete object="Plants"
do SetNumberVariable variable="PlacedPlants" modification_sign="-" value=1
do SetBooleanObjectVariable object="ShovelSlot" variable="Active" modification_sign="False"
do SetX object="ShovelIcon" modification_sign="=" value=expr(ShovelSlot.X() + 2)
do SetY object="ShovelIcon" modification_sign="=" value=expr(ShovelSlot.Y() + 3)
do SetZOrder object="ShovelIcon" modification_sign="=" value=6

@event aiGeneratedEventId="pvz-cancel-shovel"
if BooleanObjectVariable object="ShovelSlot" variable="Active" check_if_the_value_is=true
if KeyFromTextReleased key_to_check="Escape"
do SetBooleanObjectVariable object="ShovelSlot" variable="Active" modification_sign="False"
do SetX object="ShovelIcon" modification_sign="=" value=expr(ShovelSlot.X() + 2)
do SetY object="ShovelIcon" modification_sign="=" value=expr(ShovelSlot.Y() + 3)
do SetZOrder object="ShovelIcon" modification_sign="=" value=6

@comment "Activation is after removal so the click that picks up the shovel cannot remove a plant behind the HUD slot." background=[255,230,109] text=[0,0,0]

@event aiGeneratedEventId="pvz-activate-shovel"
if BooleanObjectVariable object="ShovelSlot" variable="Active" check_if_the_value_is=false
if IsCursorOnObject object="ShovelSlot" accurate_test_yes_by_default=true
if MouseButtonFromTextReleased button_to_check="Left"
do SetBooleanObjectVariable object="ShovelSlot" variable="Active" modification_sign="True"
do SetBooleanVariable variable="PlantingMode" modification_sign="False"
do SetBooleanVariable variable="HasPlacementTarget" modification_sign="False"
do SetStringVariable variable="SelectedPlantType" modification_sign="=" value=""
do Hide object="SelectedSunflower"
do Hide object="SelectedPeashooter"
do Hide object="PlacementHover"
do Hide object="PlantingHint"
do Show object="ShovelIcon"
do SetX object="ShovelIcon" modification_sign="=" value=expr(CursorX("HUD", 0) - 76)
do SetY object="ShovelIcon" modification_sign="=" value=expr(CursorY("HUD", 0) - 34)
do SetZOrder object="ShovelIcon" modification_sign="=" value=100
@end group

@group "Choose plant" source="" creationTime=0 color=[247,217,83] parameters=[]
@comment "Selection is intentionally after placement so the card click cannot also plant on the same frame." background=[255,230,109] text=[0,0,0]

@event aiGeneratedEventId="pvz-select-sunflower"
if IsCursorOnObject object="SunflowerCard" accurate_test_yes_by_default=true
if MouseButtonFromTextReleased button_to_check="Left"
do SetBooleanObjectVariable object="ShovelSlot" variable="Active" modification_sign="False"
do SetX object="ShovelIcon" modification_sign="=" value=expr(ShovelSlot.X() + 2)
do SetY object="ShovelIcon" modification_sign="=" value=expr(ShovelSlot.Y() + 3)
do SetZOrder object="ShovelIcon" modification_sign="=" value=6
do SetBooleanVariable variable="PlantingMode" modification_sign="True"
do SetBooleanVariable variable="HasPlacementTarget" modification_sign="False"
do SetStringVariable variable="SelectedPlantType" modification_sign="=" value="Sunflower"
do PlaySound audio_file_or_audio_resource_name="PVZ_SelectPlantCard" repeat_the_sound=false volume=55 pitch_speed=1
do Show object="SelectedSunflower"
do Hide object="SelectedPeashooter"
do Show object="PlantingHint"

@event aiGeneratedEventId="pvz-select-peashooter"
if IsCursorOnObject object="PeashooterCard" accurate_test_yes_by_default=true
if MouseButtonFromTextReleased button_to_check="Left"
do SetBooleanObjectVariable object="ShovelSlot" variable="Active" modification_sign="False"
do SetX object="ShovelIcon" modification_sign="=" value=expr(ShovelSlot.X() + 2)
do SetY object="ShovelIcon" modification_sign="=" value=expr(ShovelSlot.Y() + 3)
do SetZOrder object="ShovelIcon" modification_sign="=" value=6
do SetBooleanVariable variable="PlantingMode" modification_sign="True"
do SetBooleanVariable variable="HasPlacementTarget" modification_sign="False"
do SetStringVariable variable="SelectedPlantType" modification_sign="=" value="Peashooter"
do PlaySound audio_file_or_audio_resource_name="PVZ_SelectPlantCard" repeat_the_sound=false volume=55 pitch_speed=1
do Hide object="SelectedSunflower"
do Show object="SelectedPeashooter"
do Show object="PlantingHint"

@comment "Keep the bottom-anchored plant preview below the seed card while the pointer is still over the HUD." background=[255,230,109] text=[0,0,0]

@event aiGeneratedEventId="pvz-offset-preview-below-seed-card"
if BooleanVariable variable="PlantingMode" check_if_the_value_is=true
if IsCursorOnObject object="SunflowerCard" accurate_test_yes_by_default=true
or IsCursorOnObject object="PeashooterCard" accurate_test_yes_by_default=true
if Raycaster3D::RaycastFromCameraCursor objects_to_test_against_the_ray="PlantCursorSurface" parameter_2d_layer="HUD" ray_maximum_distance_in_pixels=10000
> @event aiGeneratedEventId="pvz-offset-sunflower-below-seed-card"
> if StringVariable variable="SelectedPlantType" comparison_sign="=" value="Sunflower"
> do Show object="SelectedSunflower"
> do SetX object="SelectedSunflower" modification_sign="=" value=expr((Variable(CameraTargetX) + Variable(CameraDistance) * cos(ToRad(Variable(CameraOrbitAngle) + 90)) * cos(ToRad(Variable(CameraElevationAngle)))) + (Raycaster3D::IntersectionX() - (Variable(CameraTargetX) + Variable(CameraDistance) * cos(ToRad(Variable(CameraOrbitAngle) + 90)) * cos(ToRad(Variable(CameraElevationAngle))))) * 30 / Raycaster3D::Distance() + 4.5 * cos(ToRad(Variable(CameraOrbitAngle) + 90)) * sin(ToRad(Variable(CameraElevationAngle))))
> do SetY object="SelectedSunflower" modification_sign="=" value=expr((Variable(CameraTargetY) + Variable(CameraDistance) * sin(ToRad(Variable(CameraOrbitAngle) + 90)) * cos(ToRad(Variable(CameraElevationAngle)))) + (Raycaster3D::IntersectionY() - (Variable(CameraTargetY) + Variable(CameraDistance) * sin(ToRad(Variable(CameraOrbitAngle) + 90)) * cos(ToRad(Variable(CameraElevationAngle))))) * 30 / Raycaster3D::Distance() + 4.5 * sin(ToRad(Variable(CameraOrbitAngle) + 90)) * sin(ToRad(Variable(CameraElevationAngle))))
> do Scene3D::Base3DBehavior::SetZ parameter_3d_object="SelectedSunflower" behavior="Base3D" modification_sign="=" value=expr((Variable(CameraTargetZ) + Variable(CameraDistance) * sin(ToRad(Variable(CameraElevationAngle)))) + (Raycaster3D::IntersectionZ() - (Variable(CameraTargetZ) + Variable(CameraDistance) * sin(ToRad(Variable(CameraElevationAngle))))) * 30 / Raycaster3D::Distance() - 4.5 * cos(ToRad(Variable(CameraElevationAngle))))
> do ResizableCapability::ResizableBehavior::SetWidth object="SelectedSunflower" behavior="Resizable" modification_sign="=" width=expr(76 * 30 / Raycaster3D::Distance())
> do ResizableCapability::ResizableBehavior::SetHeight object="SelectedSunflower" behavior="Resizable" modification_sign="=" height=expr(76 * 30 / Raycaster3D::Distance())
> do Scene3D::Base3DBehavior::SetDepth parameter_3d_object="SelectedSunflower" behavior="Base3D" modification_sign="=" value=expr(86 * 30 / Raycaster3D::Distance())

> @event aiGeneratedEventId="pvz-offset-peashooter-below-seed-card"
> if StringVariable variable="SelectedPlantType" comparison_sign="=" value="Peashooter"
> do Show object="SelectedPeashooter"
> do SetX object="SelectedPeashooter" modification_sign="=" value=expr((Variable(CameraTargetX) + Variable(CameraDistance) * cos(ToRad(Variable(CameraOrbitAngle) + 90)) * cos(ToRad(Variable(CameraElevationAngle)))) + (Raycaster3D::IntersectionX() - (Variable(CameraTargetX) + Variable(CameraDistance) * cos(ToRad(Variable(CameraOrbitAngle) + 90)) * cos(ToRad(Variable(CameraElevationAngle))))) * 30 / Raycaster3D::Distance() + 4.5 * cos(ToRad(Variable(CameraOrbitAngle) + 90)) * sin(ToRad(Variable(CameraElevationAngle))))
> do SetY object="SelectedPeashooter" modification_sign="=" value=expr((Variable(CameraTargetY) + Variable(CameraDistance) * sin(ToRad(Variable(CameraOrbitAngle) + 90)) * cos(ToRad(Variable(CameraElevationAngle)))) + (Raycaster3D::IntersectionY() - (Variable(CameraTargetY) + Variable(CameraDistance) * sin(ToRad(Variable(CameraOrbitAngle) + 90)) * cos(ToRad(Variable(CameraElevationAngle))))) * 30 / Raycaster3D::Distance() + 4.5 * sin(ToRad(Variable(CameraOrbitAngle) + 90)) * sin(ToRad(Variable(CameraElevationAngle))))
> do Scene3D::Base3DBehavior::SetZ parameter_3d_object="SelectedPeashooter" behavior="Base3D" modification_sign="=" value=expr((Variable(CameraTargetZ) + Variable(CameraDistance) * sin(ToRad(Variable(CameraElevationAngle)))) + (Raycaster3D::IntersectionZ() - (Variable(CameraTargetZ) + Variable(CameraDistance) * sin(ToRad(Variable(CameraElevationAngle))))) * 30 / Raycaster3D::Distance() - 4.5 * cos(ToRad(Variable(CameraElevationAngle))))
> do ResizableCapability::ResizableBehavior::SetWidth object="SelectedPeashooter" behavior="Resizable" modification_sign="=" width=expr(76 * 30 / Raycaster3D::Distance())
> do ResizableCapability::ResizableBehavior::SetHeight object="SelectedPeashooter" behavior="Resizable" modification_sign="=" height=expr(76 * 30 / Raycaster3D::Distance())
> do Scene3D::Base3DBehavior::SetDepth parameter_3d_object="SelectedPeashooter" behavior="Base3D" modification_sign="=" value=expr(76 * 30 / Raycaster3D::Distance())
@end group

@group "Wave progression and centered HUD" source="" creationTime=0 color=[198,145,58] parameters=[]
@event aiGeneratedEventId="pvz-center-and-update-wave-meter"
if BooleanVariable variable="BattleEnded" check_if_the_value_is=false
do SetX object="WaveMeter" modification_sign="=" value=expr((SceneWindowWidth() - WaveMeter.Width()) / 2)
do SetY object="WaveMeter" modification_sign="=" value=expr(SceneWindowHeight() - 115)
do SetX object="WaveFlagMarker" modification_sign="=" value=expr(WaveMeter.X() - WaveFlagMarker.Width() / 2)
do SetY object="WaveFlagMarker" modification_sign="=" value=expr(WaveMeter.Y() + (WaveMeter.Height() - WaveFlagMarker.Height()) / 2)
do SetX object="WaveZombieMarker" modification_sign="=" value=expr(WaveMeter.X() + WaveMeter.Width() - WaveZombieMarker.Width() / 2 - WaveMeter.Width() * min(1, TimerElapsedTime("WaveTimer") / Variable(WaveDuration)))
do SetY object="WaveZombieMarker" modification_sign="=" value=expr(WaveMeter.Y() + (WaveMeter.Height() - WaveZombieMarker.Height()) / 2)
do SetX object="LevelLabel" modification_sign="=" value=expr((SceneWindowWidth() - LevelLabel.Width()) / 2)
do SetY object="LevelLabel" modification_sign="=" value=expr(SceneWindowHeight() - 81)

@event aiGeneratedEventId="pvz-advance-wave"
if BooleanVariable variable="BattleEnded" check_if_the_value_is=false
if BooleanVariable variable="FinalWaveElapsed" check_if_the_value_is=false
if NumberVariable variable="CurrentWave" comparison_sign="<" value=5
if CompareTimer timer_name="WaveTimer" comparison_sign=">=" time_in_seconds=expr(Variable(WaveDuration))
do SetNumberVariable variable="CurrentWave" modification_sign="+" value=1
do SetNumberVariable variable="ZombieSpawnInterval" modification_sign="=" value=expr(36 - 6 * Variable(CurrentWave))
do SetNumberVariable variable="ZombieMoveSpeed" modification_sign="=" value=expr(18 + 4 * Variable(CurrentWave))
do TextContainerCapability::TextContainerBehavior::SetValue object="LevelLabel" behavior="Text" modification_sign="=" text=expr("FRONT YARD  -  WAVE " + ToString(Variable(CurrentWave)) + " / 5")
do ResetTimer timer_name="WaveTimer"
do ResetTimer timer_name="ZombieSpawn"

@event aiGeneratedEventId="pvz-finish-final-wave-timer"
if BooleanVariable variable="BattleEnded" check_if_the_value_is=false
if BooleanVariable variable="FinalWaveElapsed" check_if_the_value_is=false
if NumberVariable variable="CurrentWave" comparison_sign="=" value=5
if CompareTimer timer_name="WaveTimer" comparison_sign=">=" time_in_seconds=expr(Variable(WaveDuration))
do SetBooleanVariable variable="FinalWaveElapsed" modification_sign="True"

@event aiGeneratedEventId="pvz-win-after-final-wave"
if BooleanVariable variable="BattleEnded" check_if_the_value_is=false
if BooleanVariable variable="FinalWaveElapsed" check_if_the_value_is=true
if SceneInstancesCount object="Zombie" comparison_sign="=" value=0
do SetBooleanVariable variable="BattleEnded" modification_sign="True"
do TextContainerCapability::TextContainerBehavior::SetValue object="LevelLabel" behavior="Text" modification_sign="=" text="FRONT YARD  -  ALL 5 WAVES CLEARED!"
do SetX object="LevelLabel" modification_sign="=" value=expr((SceneWindowWidth() - LevelLabel.Width()) / 2)
do PlaySound audio_file_or_audio_resource_name="assets\\sfx-victory.wav" repeat_the_sound=false volume=70 pitch_speed=1
@end group

@group "Zombie spawning and lane movement" source="" creationTime=0 color=[150,105,84] parameters=[]
@event aiGeneratedEventId="pvz-spawn-random-zombie"
if BooleanVariable variable="BattleEnded" check_if_the_value_is=false
if BooleanVariable variable="FinalWaveElapsed" check_if_the_value_is=false
if CompareTimer timer_name="ZombieSpawn" comparison_sign=">=" time_in_seconds=expr(Variable(ZombieSpawnInterval))
if PickRandomInstance object="ZombieSpawnPoint"
do Create object_to_create="Zombie" x_position=expr(ZombieSpawnPoint.X()) y_position=expr(ZombieSpawnPoint.Y()) layer=""
do Scene3D::Base3DBehavior::SetZ parameter_3d_object="Zombie" behavior="Base3D" modification_sign="=" value=5
do SetNumberObjectVariable object="Zombie" variable="HP" modification_sign="=" value=expr(70 + 30 * Variable(CurrentWave))
do SetNumberObjectVariable object="Zombie" variable="MaxHP" modification_sign="=" value=expr(70 + 30 * Variable(CurrentWave))
do PlaySound audio_file_or_audio_resource_name="PVZ_ZombieVoice" repeat_the_sound=false volume=45 pitch_speed=1
do ResetObjectTimer object="Zombie" timer_name="AttackCooldown"
do ResetTimer timer_name="ZombieSpawn"

@event aiGeneratedEventId="pvz-each-zombie-acquire-target"
for each "Zombie"
> @event
> if BooleanVariable variable="BattleEnded" check_if_the_value_is=false
> if PickNearest object="Plants" x_position=expr(Zombie.X()) y_position=expr(Zombie.Y())
> do SetNumberObjectVariable object="Zombie" variable="TargetX" modification_sign="=" value=expr(Plants.X())
> do SetNumberObjectVariable object="Zombie" variable="TargetY" modification_sign="=" value=expr(Plants.Y())

@event aiGeneratedEventId="pvz-each-zombie-clear-target-without-plants"
for each "Zombie"
> @event
> if BooleanVariable variable="BattleEnded" check_if_the_value_is=false
> if SceneInstancesCount object="Plants" comparison_sign="=" value=0
> do SetNumberObjectVariable object="Zombie" variable="TargetX" modification_sign="=" value=-100000
> do SetNumberObjectVariable object="Zombie" variable="TargetY" modification_sign="=" value=expr(Zombie.Y())

@event aiGeneratedEventId="pvz-each-zombie-walk-when-clear"
for each "Zombie"
> @event
> if BooleanVariable variable="BattleEnded" check_if_the_value_is=false
> if BuiltinCommonInstructions::CompareNumbers first_expression=expr((Zombie.X() - Zombie.Variable(TargetX)) * (Zombie.X() - Zombie.Variable(TargetX)) + (Zombie.Y() - Zombie.Variable(TargetY)) * (Zombie.Y() - Zombie.Variable(TargetY))) comparison_sign=">" second_expression=2025
> do SetX object="Zombie" modification_sign="=" value=expr(Zombie.X() - Variable(ZombieMoveSpeed) * TimeDelta())

@event aiGeneratedEventId="pvz-each-zombie-return-to-walk"
for each "Zombie"
> @event
> if BooleanVariable variable="BattleEnded" check_if_the_value_is=false
> if BuiltinCommonInstructions::CompareNumbers first_expression=expr((Zombie.X() - Zombie.Variable(TargetX)) * (Zombie.X() - Zombie.Variable(TargetX)) + (Zombie.Y() - Zombie.Variable(TargetY)) * (Zombie.Y() - Zombie.Variable(TargetY))) comparison_sign=">" second_expression=2025
> if NumberObjectVariable object="Zombie" variable="Attacking" comparison_sign="=" value=1
> do EmitSignalToObjectInstance instance_id=expr(Zombie.InstanceId()) signal_name="Zombie.Walk" payload=""
> do SetNumberObjectVariable object="Zombie" variable="Attacking" modification_sign="=" value=0

@event aiGeneratedEventId="pvz-each-zombie-enter-attack"
for each "Zombie"
> @event
> if BooleanVariable variable="BattleEnded" check_if_the_value_is=false
> if BuiltinCommonInstructions::CompareNumbers first_expression=expr((Zombie.X() - Zombie.Variable(TargetX)) * (Zombie.X() - Zombie.Variable(TargetX)) + (Zombie.Y() - Zombie.Variable(TargetY)) * (Zombie.Y() - Zombie.Variable(TargetY))) comparison_sign="<=" second_expression=2025
> if NumberObjectVariable object="Zombie" variable="Attacking" comparison_sign="=" value=0
> do EmitSignalToObjectInstance instance_id=expr(Zombie.InstanceId()) signal_name="Zombie.Attack" payload=""
> do SetNumberObjectVariable object="Zombie" variable="Attacking" modification_sign="=" value=1
> do ResetObjectTimer object="Zombie" timer_name="AttackCooldown"

@event aiGeneratedEventId="pvz-each-zombie-deal-signal-damage"
for each "Zombie"
> @event
> if BooleanVariable variable="BattleEnded" check_if_the_value_is=false
> if Collision3D::AreInCollision object="Zombie" first_parameter_3d_capability="Base3D" other_object="Plants" second_parameter_3d_capability="Base3D" ignore_objects_that_are_touching_each_other_on_their_edges_but_are_not_overlapping_default_no=false
> if PickNearest object="Plants" x_position=expr(Zombie.X()) y_position=expr(Zombie.Y())
> if NumberObjectVariable object="Zombie" variable="Attacking" comparison_sign="=" value=1
> if CompareObjectTimer object="Zombie" timer_name="AttackCooldown" comparison_sign=">=" time_in_seconds=1
> do EmitSignalToObjectInstance instance_id=expr(Plants.InstanceId()) signal_name="Unit.Damage" payload="1"
> do PlaySound audio_file_or_audio_resource_name="PVZ_ZombieEat" repeat_the_sound=false volume=45 pitch_speed=1
> do ResetObjectTimer object="Zombie" timer_name="AttackCooldown"

@event aiGeneratedEventId="pvz-remove-zombie-at-house"
if BooleanVariable variable="BattleEnded" check_if_the_value_is=false
if PosX object="Zombie" comparison_sign="<" value=180
do SetBooleanVariable variable="BattleEnded" modification_sign="True"
do TextContainerCapability::TextContainerBehavior::SetValue object="LevelLabel" behavior="Text" modification_sign="=" text="GAME OVER  -  ZOMBIES ATE YOUR BRAINS!"
do SetX object="LevelLabel" modification_sign="=" value=expr((SceneWindowWidth() - LevelLabel.Width()) / 2)
do PlaySound audio_file_or_audio_resource_name="assets\\sfx-defeat.wav" repeat_the_sound=false volume=75 pitch_speed=1
@end group

@group "Peashooter combat" source="" creationTime=0 color=[84,190,102] parameters=[]
@event aiGeneratedEventId="pvz-each-pea-hit"
for each "PeaProjectile"
> @event aiGeneratedEventId="pvz-pea-hits-zombie"
> if Collision3D::AreInCollision object="PeaProjectile" first_parameter_3d_capability="Base3D" other_object="Zombie" second_parameter_3d_capability="Base3D" ignore_objects_that_are_touching_each_other_on_their_edges_but_are_not_overlapping_default_no=false
> if PickNearest object="Zombie" x_position=expr(PeaProjectile.X()) y_position=expr(PeaProjectile.Y())
> do EmitSignalToObjectInstance instance_id=expr(Zombie.InstanceId()) signal_name="Unit.Damage" payload="20"
> do PlaySound audio_file_or_audio_resource_name="PVZ_ZombieDamage" repeat_the_sound=false volume=50 pitch_speed=1
> do Delete object="PeaProjectile"
@end group
