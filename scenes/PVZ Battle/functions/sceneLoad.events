@event aiGeneratedEventId="pvz-initialize-planting-camera"
do SetNumberVariable variable="CameraOrbitAngle" modification_sign="=" value=-90
do SetNumberVariable variable="CameraDragStartX" modification_sign="=" value=0
do SetNumberVariable variable="CameraDragStartAngle" modification_sign="=" value=-90
do SetBooleanVariable variable="PlantingMode" modification_sign="False"
do SetBooleanVariable variable="HasPlacementTarget" modification_sign="False"
do SetNumberVariable variable="PlacedPlants" modification_sign="=" value=0
do ThirdPersonCamera::ThirdPersonCamera::SetTargetedRotationAngle object="KunKun" behavior="ThirdPersonCamera" modification_sign="=" value=-90
do Hide object="SelectedSunflower"
do Hide object="PlacementHover"
do Hide object="PlantingHint"
