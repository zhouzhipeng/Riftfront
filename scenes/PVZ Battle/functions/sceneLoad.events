@event aiGeneratedEventId="pvz-initialize-planting-camera"
do BuiltinExternalLayouts::CreateObjectsFromExternalLayout name_of_the_external_layout="PVZ Battle UI" x_position_of_the_origin=0 y_position_of_the_origin=0 z_position_of_the_origin=0
do BuiltinExternalLayouts::CreateObjectsFromExternalLayout name_of_the_external_layout="PVZ Battle HUD" x_position_of_the_origin=0 y_position_of_the_origin=0 z_position_of_the_origin=0
do PlayMusic audio_file_or_audio_resource_name="PVZ_Faster_BGM" repeat_the_sound=true volume=45 pitch_speed=1
do SetNumberVariable variable="CameraOrbitAngle" modification_sign="=" value=-1.31140401
do SetNumberVariable variable="CameraDragStartX" modification_sign="=" value=0
do SetNumberVariable variable="CameraDragStartAngle" modification_sign="=" value=-1.31140401
do SetNumberVariable variable="CameraTargetX" modification_sign="=" value=710.53410809
do SetNumberVariable variable="CameraTargetY" modification_sign="=" value=364.88828065
do SetNumberVariable variable="CameraTargetZ" modification_sign="=" value=0
do SetNumberVariable variable="CameraDistance" modification_sign="=" value=791.19003525
do SetNumberVariable variable="CameraElevationAngle" modification_sign="=" value=41.53797907
do SetNumberVariable variable="CameraDragStartY" modification_sign="=" value=0
do SetNumberVariable variable="CameraDragStartElevation" modification_sign="=" value=41.53797907
do SetNumberVariable variable="CameraPanLastX" modification_sign="=" value=0
do SetNumberVariable variable="CameraPanLastY" modification_sign="=" value=0
do SetNumberVariable variable="BillboardCameraRotationX" modification_sign="=" value=expr(Variable(CameraElevationAngle) - 90)
do SetNumberVariable variable="BillboardCameraRotationY" modification_sign="=" value=0
do SetNumberVariable variable="BillboardCameraRotationZ" modification_sign="=" value=expr(Variable(CameraOrbitAngle))
do SetBooleanVariable variable="PlantingMode" modification_sign="False"
do SetBooleanVariable variable="HasPlacementTarget" modification_sign="False"
do SetNumberVariable variable="PlacedPlants" modification_sign="=" value=0
do SetNumberVariable variable="SunAmount" modification_sign="=" value=500
do SetBooleanVariable variable="SunCollectedThisFrame" modification_sign="False"
do SetStringVariable variable="SelectedPlantType" modification_sign="=" value=""
do SetNumberVariable variable="CurrentWave" modification_sign="=" value=1
do SetNumberVariable variable="WaveDuration" modification_sign="=" value=60
do SetNumberVariable variable="ZombieSpawnInterval" modification_sign="=" value=30
do SetNumberVariable variable="ZombieMoveSpeed" modification_sign="=" value=22
do SetBooleanVariable variable="FinalWaveElapsed" modification_sign="False"
do SetBooleanVariable variable="BattleEnded" modification_sign="False"
do SetNumberVariable variable="HouseBreach" modification_sign="=" value=0
do SetBooleanVariable variable="SunflowerChosen" modification_sign="False"
do SetBooleanVariable variable="PeashooterChosen" modification_sign="False"
do SetBooleanVariable variable="BattleActive" modification_sign="False"
do SetNumberVariable variable="FightCountdownStage" modification_sign="=" value=0
do SetBooleanObjectVariable object="ShovelSlot" variable="Active" modification_sign="False"
do SetX object="ShovelIcon" modification_sign="=" value=expr(ShovelSlot.X() + 2)
do SetY object="ShovelIcon" modification_sign="=" value=expr(ShovelSlot.Y() + 3)
do SetZOrder object="ShovelIcon" modification_sign="=" value=6
do TextContainerCapability::TextContainerBehavior::SetValue object="SunCounter" behavior="Text" modification_sign="=" text=expr("SUN  " + ToString(Variable(SunAmount)))
do TextContainerCapability::TextContainerBehavior::SetValue object="LevelLabel" behavior="Text" modification_sign="=" text="FRONT YARD  -  WAVE 1 / 5"
do SetX object="WaveMeter" modification_sign="=" value=expr((SceneWindowWidth() - WaveMeter.Width()) / 2)
do SetY object="WaveMeter" modification_sign="=" value=expr(SceneWindowHeight() - 115)
do SetX object="WaveFlagMarker" modification_sign="=" value=expr(WaveMeter.X() - WaveFlagMarker.Width() / 2)
do SetY object="WaveFlagMarker" modification_sign="=" value=expr(WaveMeter.Y() + (WaveMeter.Height() - WaveFlagMarker.Height()) / 2)
do SetX object="WaveZombieMarker" modification_sign="=" value=expr(WaveMeter.X() + WaveMeter.Width() - WaveZombieMarker.Width() / 2)
do SetY object="WaveZombieMarker" modification_sign="=" value=expr(WaveMeter.Y() + (WaveMeter.Height() - WaveZombieMarker.Height()) / 2)
do SetX object="LevelLabel" modification_sign="=" value=expr((SceneWindowWidth() - LevelLabel.Width()) / 2)
do SetY object="LevelLabel" modification_sign="=" value=expr(SceneWindowHeight() - 81)
do SetX object="FightStartSet" modification_sign="=" value=expr((SceneWindowWidth() - FightStartSet.Width()) / 2)
do SetY object="FightStartSet" modification_sign="=" value=expr((SceneWindowHeight() - FightStartSet.Height()) / 2)
do SetX object="FightStartReady" modification_sign="=" value=expr((SceneWindowWidth() - FightStartReady.Width()) / 2)
do SetY object="FightStartReady" modification_sign="=" value=expr((SceneWindowHeight() - FightStartReady.Height()) / 2)
do SetX object="FightStartPlant" modification_sign="=" value=expr((SceneWindowWidth() - FightStartPlant.Width()) / 2)
do SetY object="FightStartPlant" modification_sign="=" value=expr((SceneWindowHeight() - FightStartPlant.Height()) / 2)
do ThirdPersonCamera::LookFromDistanceAtPosition3D position_on_x_axis=expr(Variable(CameraTargetX)) position_on_y_axis=expr(Variable(CameraTargetY)) position_on_z_axis=expr(Variable(CameraTargetZ)) distance=expr(Variable(CameraDistance)) rotation_angle_around_z_axis=expr(Variable(CameraOrbitAngle)) elevation_angle_around_y_axis=expr(Variable(CameraElevationAngle)) layer=""
do ResetTimer timer_name="SunSpawn"
do ResetTimer timer_name="ZombieSpawn"
do ResetTimer timer_name="WaveTimer"
do Hide object="SelectedSunflower"
do Hide object="SelectedPeashooter"
do Hide object="PlacementHover"
do Hide object="PlantingHint"
do Hide object="ZombieSpawnPoint"
do Hide object="ZombiesWon"
do Hide object="FightStartSet"
do Hide object="FightStartReady"
do Hide object="FightStartPlant"
