type = "number"
value = 0

[layout]
version = 1
background = "#21472B"

[layout.editor]
grid = true
grid_type = "rectangular"
grid_size = [100, 100, 25]
grid_offset = [0, 0, 0]
grid_color = "#9EB4FF"
grid_alpha = 0.8
snap = true
zoom = 0.36942475881734455
window_mask = false
selected_layer = ""
mode = "instances-editor"

[[layout.layers]]
id = "base"
name = ""
rendering = "3d"
camera_type = "perspective"
camera_behavior = "do-nothing"
ambient = "#D6E8C4"
far = 5000
fov = 40
max_2d_distance = 2000
cameras = [{ size = "default", viewport = "default" }]

[[layout.layers]]
id = "hud"
name = "HUD"
rendering = "2d"
locked = true
cameras = [{ size = "default", viewport = "default" }]

[[layout.effects]]
layer = "base"
name = "3D Ambient Hemisphere Light"
type = "Scene3D::HemisphereLight"
elevation = 55
groundColor = "76;101;53"
intensity = 0.45
rotation = 320
skyColor = "255;246;220"
top = "Z+"

[[layout.effects]]
layer = "base"
name = "3D Sun Light"
type = "Scene3D::DirectionalLight"
color = "255;255;255"
distanceFromCamera = 1500
elevation = 52
frustumSize = 2200
intensity = 0.9
isCastingShadow = true
minimumShadowBias = 0.001
rotation = 325
shadowQuality = "medium"
top = "Z+"

[[layout.effects]]
layer = "base"
name = "Sunny Exposure"
type = "Scene3D::Exposure"
exposure = 0.88

