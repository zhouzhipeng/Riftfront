kind = "scene"
settingsFormatVersion = 5
order = 3
disableInputWhenNotFocused = true
mangledName = "PVZ_32Battle"
name = "PVZ Battle"
standardSortMethod = true
stopSoundsOnStartup = true
title = ""
sceneLifecycleFunctions = [ "sceneLoad", "sceneUpdate" ]
behaviorsSharedData = [ ]
objectGroups = { }

[[variables]]
name = "CameraOrbitAngle"
persistentUuid = "3d4da1e3-7a44-4a2b-9eed-b3df5741b337"
type = "number"
value = -90

[[variables]]
name = "CameraDragStartX"
persistentUuid = "ae45f466-e595-4851-b4b6-2c0bb08d7c47"
type = "number"
value = 0

[[variables]]
name = "CameraDragStartAngle"
persistentUuid = "011e126e-9d14-401e-8f72-aaeaa03e47dc"
type = "number"
value = -90

[[variables]]
name = "PlantingMode"
persistentUuid = "42a376d5-bfb4-471f-ad9f-34ac1cdf398c"
type = "boolean"
value = false

[[variables]]
name = "HasPlacementTarget"
persistentUuid = "d64c5962-2360-44ce-8c01-eaac5d0006ca"
type = "boolean"
value = false

[[variables]]
