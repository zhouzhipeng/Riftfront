@group "Keyboard movement and turning" source="" creationTime=0 color=[255,183,77] parameters=[]
@event aiGeneratedEventId="battle-move-forward"
if KeyFromTextPressed key_to_check="w"
or KeyFromTextPressed key_to_check="Up"
do Physics3D::PhysicsCharacter3D::SetForwardAngle object="TwinKunai" behavior="PhysicsCharacter3D" modification_sign="=" angle_in_degrees=expr(Variable(CameraOrbitAngle) - 180)
do SetAngle object="TwinKunai" modification_sign="=" angle_in_degrees=expr(Variable(CameraOrbitAngle) - 90)
do Physics3D::PhysicsCharacter3D::SimulateForwardKey object="TwinKunai" behavior="PhysicsCharacter3D"

@event aiGeneratedEventId="battle-move-backward"
if KeyFromTextPressed key_to_check="s"
or KeyFromTextPressed key_to_check="Down"
do Physics3D::PhysicsCharacter3D::SetForwardAngle object="TwinKunai" behavior="PhysicsCharacter3D" modification_sign="=" angle_in_degrees=expr(Variable(CameraOrbitAngle))
do SetAngle object="TwinKunai" modification_sign="=" angle_in_degrees=expr(Variable(CameraOrbitAngle) + 90)
do Physics3D::PhysicsCharacter3D::SimulateForwardKey object="TwinKunai" behavior="PhysicsCharacter3D"

@event aiGeneratedEventId="battle-move-left"
if KeyFromTextPressed key_to_check="a"
or KeyFromTextPressed key_to_check="Left"
do Physics3D::PhysicsCharacter3D::SetForwardAngle object="TwinKunai" behavior="PhysicsCharacter3D" modification_sign="+" angle_in_degrees=expr(90 * TimeDelta())
do SetAngle object="TwinKunai" modification_sign="+" angle_in_degrees=expr(90 * TimeDelta())

@event aiGeneratedEventId="battle-move-right"
if KeyFromTextPressed key_to_check="d"
or KeyFromTextPressed key_to_check="Right"
do Physics3D::PhysicsCharacter3D::SetForwardAngle object="TwinKunai" behavior="PhysicsCharacter3D" modification_sign="-" angle_in_degrees=expr(90 * TimeDelta())
do SetAngle object="TwinKunai" modification_sign="-" angle_in_degrees=expr(90 * TimeDelta())

@event aiGeneratedEventId="battle-jump"
if KeyFromTextPressed key_to_check="Space"
do Physics3D::PhysicsCharacter3D::SimulateJumpKey object="TwinKunai" behavior="PhysicsCharacter3D"
@end group

@group "Locked mouse camera orbit" source="" creationTime=0 color=[91,203,255] parameters=[]
@event aiGeneratedEventId="battle-request-pointer-lock"
if HasAnyTouchOrMouseStarted
do MousePointerLock::RequestPointerLock

@event aiGeneratedEventId="battle-orbit-camera-with-mouse"
if MousePointerLock::isPointerLocked
if MousePointerLock::MovementX comparison_sign="!=" value=0
do SetNumberVariable variable="CameraOrbitAngle" modification_sign="+" value=expr(MousePointerLock::MovementX() * 0.18)
@end group

@group "Mouse combo attack" source="" creationTime=0 color=[255,92,92] parameters=[]
@event aiGeneratedEventId="battle-combo-left-click"
if MouseButtonFromTextPressed button_to_check="Left"
if BuiltinCommonInstructions::Once
do Local::TwinKunai3D::PlayAnimation twin_kunai_prefab="TwinKunai" animation_index_from_0_to_28=1
do ResetTimer timer_name="TwinKunaiComboTimer"

@event aiGeneratedEventId="battle-combo-second-hit"
if CompareTimer timer_name="TwinKunaiComboTimer" comparison_sign=">=" time_in_seconds=0.4
if CompareTimer timer_name="TwinKunaiComboTimer" comparison_sign="<" time_in_seconds=0.8
if BuiltinCommonInstructions::Once
do Local::TwinKunai3D::PlayAnimation twin_kunai_prefab="TwinKunai" animation_index_from_0_to_28=2

@event aiGeneratedEventId="battle-combo-third-hit"
if CompareTimer timer_name="TwinKunaiComboTimer" comparison_sign=">=" time_in_seconds=0.8
if CompareTimer timer_name="TwinKunaiComboTimer" comparison_sign="<" time_in_seconds=1.35
if BuiltinCommonInstructions::Once
do Local::TwinKunai3D::PlayAnimation twin_kunai_prefab="TwinKunai" animation_index_from_0_to_28=3

@event aiGeneratedEventId="battle-combo-finish"
if CompareTimer timer_name="TwinKunaiComboTimer" comparison_sign=">=" time_in_seconds=1.35
do RemoveTimer timer_name="TwinKunaiComboTimer"
@end group

@group "Character animation" source="" creationTime=0 color=[126,211,126] parameters=[]
@event aiGeneratedEventId="battle-turn-left-animation"
if KeyFromTextPressed key_to_check="a"
or KeyFromTextPressed key_to_check="Left"
@instruction inverted=true
if CompareTimer timer_name="TwinKunaiComboTimer" comparison_sign="<" time_in_seconds=1.35
if BuiltinCommonInstructions::Once
do Local::TwinKunai3D::PlayAnimation twin_kunai_prefab="TwinKunai" animation_index_from_0_to_28=26

@event aiGeneratedEventId="battle-turn-right-animation"
if KeyFromTextPressed key_to_check="d"
or KeyFromTextPressed key_to_check="Right"
@instruction inverted=true
if CompareTimer timer_name="TwinKunaiComboTimer" comparison_sign="<" time_in_seconds=1.35
if BuiltinCommonInstructions::Once
do Local::TwinKunai3D::PlayAnimation twin_kunai_prefab="TwinKunai" animation_index_from_0_to_28=27

@event aiGeneratedEventId="battle-walk-animation"
if Physics3D::PhysicsCharacter3D::IsMovingEvenALittle object="TwinKunai" behavior="PhysicsCharacter3D"
@instruction inverted=true
if KeyFromTextPressed key_to_check="a"
@instruction inverted=true
if KeyFromTextPressed key_to_check="Left"
@instruction inverted=true
if KeyFromTextPressed key_to_check="d"
@instruction inverted=true
if KeyFromTextPressed key_to_check="Right"
@instruction inverted=true
if CompareTimer timer_name="TwinKunaiComboTimer" comparison_sign="<" time_in_seconds=1.35
if BuiltinCommonInstructions::Once
do Local::TwinKunai3D::PlayAnimation twin_kunai_prefab="TwinKunai" animation_index_from_0_to_28=16

@event aiGeneratedEventId="battle-idle-animation"
@instruction inverted=true
if Physics3D::PhysicsCharacter3D::IsMovingEvenALittle object="TwinKunai" behavior="PhysicsCharacter3D"
@instruction inverted=true
if KeyFromTextPressed key_to_check="a"
@instruction inverted=true
if KeyFromTextPressed key_to_check="Left"
@instruction inverted=true
if KeyFromTextPressed key_to_check="d"
@instruction inverted=true
if KeyFromTextPressed key_to_check="Right"
@instruction inverted=true
if CompareTimer timer_name="TwinKunaiComboTimer" comparison_sign="<" time_in_seconds=1.35
if BuiltinCommonInstructions::Once
do Local::TwinKunai3D::PlayAnimation twin_kunai_prefab="TwinKunai" animation_index_from_0_to_28=0
@end group

@group "Constrained spring-arm camera" source="" creationTime=0 color=[143,108,255] parameters=[]
@event aiGeneratedEventId="battle-camera-follow"
if Physics3D::PhysicsCharacter3D::ForwardSpeedMax object="TwinKunai" behavior="PhysicsCharacter3D" comparison_sign=">" speed_in_pixels_per_second=0
do SetCameraCenterX modification_sign="=" value=expr(lerp(CameraCenterX("", 0), TwinKunai.X() + cos(ToRad(Variable(CameraOrbitAngle))) * 650, min(1, 10 * TimeDelta()))) layer="" camera_number_default_0=0
do SetCameraCenterY modification_sign="=" value=expr(lerp(CameraCenterY("", 0), TwinKunai.Y() + sin(ToRad(Variable(CameraOrbitAngle))) * 650, min(1, 10 * TimeDelta()))) layer="" camera_number_default_0=0
do Scene3D::SetCameraZ modification_sign="=" value=expr(lerp(Scene3D::CameraZ("", 0), TwinKunai.Base3D::Z() + 280, min(1, 10 * TimeDelta()))) layer="" camera_number_default_0=0
do Scene3D::TurnCameraTowardPosition x_position=expr(TwinKunai.X() - cos(ToRad(Variable(CameraOrbitAngle))) * 160) y_position=expr(TwinKunai.Y() - sin(ToRad(Variable(CameraOrbitAngle))) * 160) z_position=expr(TwinKunai.Base3D::Z() + 115) layer="" camera_number_default_0=0 stand_on_y_instead_of_z=false
@end group
