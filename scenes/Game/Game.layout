[layout]
version = 1
background = "#071833"

[editor]
grid = true
grid_type = "rectangular"
grid_size = [16, 16, 16]
grid_offset = [0, 0, 0]
grid_color = "#72DDF7"
grid_alpha = 0.35
snap = false
zoom = 0.78
window_mask = true
selected_layer = "HUD"
mode = "instances-editor"

[[layers]]
id = "backdrop"
name = "Backdrop"
rendering = "2d"
visible = true
locked = true
lighting = false
cameras = [{ size = "default", viewport = "default" }]

[[layers]]
id = "base"
name = ""
rendering = "2d+3d"
camera_type = "perspective"
camera_behavior = "top-left-anchored-if-never-moved"
visible = true
locked = false
lighting = false
follow_base_camera = false
ambient = "#A8C4DF"
near = 3
far = 5_000
fov = 42
max_2d_distance = 2_000
cameras = [{ size = "default", viewport = "default" }]

[[layers]]
id = "hud"
name = "HUD"
rendering = "2d"
visible = true
locked = false
lighting = false
follow_base_camera = false
cameras = [{ size = "default", viewport = "default" }]

[[effects]]
layer = "base"
name = "CelestialHemisphere"
type = "Scene3D::HemisphereLight"
enabled = true
elevation = 90
groundColor = "34;52;92"
intensity = 0.58
rotation = 0
skyColor = "196;232;255"
top = "Z+"

[[effects]]
layer = "base"
name = "CelestialSun"
type = "Scene3D::DirectionalLight"
enabled = true
color = "255;242;214"
distanceFromCamera = 1_100
elevation = 62
frustumSize = 1_600
intensity = 0.34
isCastingShadow = true
minimumShadowBias = 0.001
rotation = -35
shadowQuality = "high"
top = "Z+"

[[effects]]
layer = "base"
name = "AetherBloom"
type = "Scene3D::Bloom"
enabled = true
radius = 0.16
strength = 0.18
threshold = 0.9

