@event aiGeneratedEventId="each-enemy-movement-and-block"
for each Enemy
> @event aiGeneratedEventId="reset-enemy-block-state"
> if NumberVariable variable="GameState" comparison_sign="=" value=1
> do SetNumberObjectVariable object="Enemy" variable="Blocked" modification_sign="=" value=0

> @event aiGeneratedEventId="ground-enemy-blocked-by-hero"
> if NumberVariable variable="GameState" comparison_sign="=" value=1
> if NumberObjectVariable object="Enemy" variable="Kind" comparison_sign="!=" value=4
> if CollisionNP first_object="Enemy" second_object="Hero" ignore_objects_that_are_touching_each_other_on_their_edges_but_are_not_overlapping_default_no=false
> do SetNumberObjectVariable object="Enemy" variable="Blocked" modification_sign="=" value=1
> do SeparateFromObjects object="Enemy" objects_won_t_move="Hero" ignore_objects_that_are_touching_each_other_on_their_edges_but_are_not_overlapping_default_no=false

>> @event aiGeneratedEventId="enemy-bites-hero"
>> if CompareObjectTimer object="Enemy" timer_name="bite" comparison_sign=">=" time_in_seconds=1
>> do SetNumberObjectVariable object="Hero" variable="HP" modification_sign="-" value=expr(Enemy.Variable(Damage))
>> do ResetObjectTimer object="Enemy" timer_name="bite"
>> do PlaySound audio_file_or_audio_resource_name="assets\\sfx-hit.wav" repeat_the_sound=false volume=24 pitch_speed=0.72

> @event aiGeneratedEventId="advance-unblocked-enemy"
> if NumberVariable variable="GameState" comparison_sign="=" value=1
> if NumberObjectVariable object="Enemy" variable="Blocked" comparison_sign="=" value=0
> do SetX object="Enemy" modification_sign="=" value=expr(Enemy.X() - Enemy.Variable(Speed) * TimeDelta())

@event aiGeneratedEventId="each-projectile-hit"
for each Projectile
> @event aiGeneratedEventId="projectile-hits-enemy"
> if NumberVariable variable="GameState" comparison_sign="=" value=1
> if CollisionNP first_object="Projectile" second_object="Enemy" ignore_objects_that_are_touching_each_other_on_their_edges_but_are_not_overlapping_default_no=false
> do SetNumberObjectVariable object="Enemy" variable="HP" modification_sign="-" value=expr(Projectile.Variable(Damage))
> do Create object_to_create="Impact" x_position=expr(Enemy.CenterX() - 36) y_position=expr(Enemy.CenterY() - 36) layer=""
> do Delete object="Projectile"
> do PlaySound audio_file_or_audio_resource_name="assets\\sfx-hit.wav" repeat_the_sound=false volume=18 pitch_speed=1.2

@event aiGeneratedEventId="delete-offscreen-projectiles"
if PosX object="Projectile" comparison_sign=">" value=1280
do Delete object="Projectile"

@event aiGeneratedEventId="delete-finished-impact"
if AnimatableCapability::AnimatableBehavior::HasAnimationEnded object="Impact" behavior="Animation"
do Delete object="Impact"

@event aiGeneratedEventId="each-defeated-enemy"
for each Enemy
> @event aiGeneratedEventId="resolve-enemy-defeat"
> if NumberVariable variable="GameState" comparison_sign="=" value=1
> if NumberObjectVariable object="Enemy" variable="HP" comparison_sign="<=" value=0
> do SetNumberVariable variable="Energy" modification_sign="+" value=expr(Enemy.Variable(Reward))
> do SetNumberVariable variable="Score" modification_sign="+" value=expr(Enemy.Variable(Reward) * 10)
> do Create object_to_create="Impact" x_position=expr(Enemy.CenterX() - 36) y_position=expr(Enemy.CenterY() - 36) layer=""
> do Delete object="Enemy"
> do PlaySound audio_file_or_audio_resource_name="assets\\sfx-hit.wav" repeat_the_sound=false volume=42 pitch_speed=0.55

@event aiGeneratedEventId="each-core-breach"
for each Enemy
> @event aiGeneratedEventId="enemy-damages-core"
> if NumberVariable variable="GameState" comparison_sign="=" value=1
> if PosX object="Enemy" comparison_sign="<" value=110
> do SetNumberVariable variable="CoreHP" modification_sign="-" value=expr(Enemy.Variable(Damage))
> do Create object_to_create="Impact" x_position=70 y_position=expr(Enemy.Y()) layer=""
> do Delete object="Enemy"
> do PlaySound audio_file_or_audio_resource_name="assets\\sfx-core.wav" repeat_the_sound=false volume=56 pitch_speed=0.78

@event aiGeneratedEventId="aegis-fallen"
if NumberObjectVariable object="Hero" variable="Type" comparison_sign="=" value=1
if NumberObjectVariable object="Hero" variable="HP" comparison_sign="<=" value=0
do SetNumberVariable variable="H1Deployed" modification_sign="=" value=0
do Create object_to_create="Impact" x_position=expr(Hero.CenterX() - 36) y_position=expr(Hero.CenterY() - 36) layer=""
do Delete object="Hero"
do TextContainerCapability::TextContainerBehavior::SetValue object="StatusText" behavior="Text" modification_sign="=" text="AEGIS DOWN - REDEPLOY AVAILABLE"

@event aiGeneratedEventId="rifle-fallen"
if NumberObjectVariable object="Hero" variable="Type" comparison_sign="=" value=2
if NumberObjectVariable object="Hero" variable="HP" comparison_sign="<=" value=0
do SetNumberVariable variable="H2Deployed" modification_sign="=" value=0
do Create object_to_create="Impact" x_position=expr(Hero.CenterX() - 36) y_position=expr(Hero.CenterY() - 36) layer=""
do Delete object="Hero"
do TextContainerCapability::TextContainerBehavior::SetValue object="StatusText" behavior="Text" modification_sign="=" text="RIFLE DOWN - REDEPLOY AVAILABLE"

@event aiGeneratedEventId="shotgun-fallen"
if NumberObjectVariable object="Hero" variable="Type" comparison_sign="=" value=3
if NumberObjectVariable object="Hero" variable="HP" comparison_sign="<=" value=0
do SetNumberVariable variable="H3Deployed" modification_sign="=" value=0
do Create object_to_create="Impact" x_position=expr(Hero.CenterX() - 36) y_position=expr(Hero.CenterY() - 36) layer=""
do Delete object="Hero"
do TextContainerCapability::TextContainerBehavior::SetValue object="StatusText" behavior="Text" modification_sign="=" text="SHOTGUN DOWN - REDEPLOY AVAILABLE"

@event aiGeneratedEventId="rocket-fallen"
if NumberObjectVariable object="Hero" variable="Type" comparison_sign="=" value=4
if NumberObjectVariable object="Hero" variable="HP" comparison_sign="<=" value=0
do SetNumberVariable variable="H4Deployed" modification_sign="=" value=0
do Create object_to_create="Impact" x_position=expr(Hero.CenterX() - 36) y_position=expr(Hero.CenterY() - 36) layer=""
do Delete object="Hero"
do TextContainerCapability::TextContainerBehavior::SetValue object="StatusText" behavior="Text" modification_sign="=" text="ROCKET DOWN - REDEPLOY AVAILABLE"

@end group

@group "Skills upgrades and game end" source="" creationTime=0 color=[111,231,179] parameters=[]

@event aiGeneratedEventId="activate-hero-skill"
if NumberVariable variable="GameState" comparison_sign="=" value=1
if HasAnyTouchOrMouseStarted
if BuiltinCommonInstructions::Once
if IsCursorOnObject object="SkillButton" accurate_test_yes_by_default=true
if BuiltinCommonInstructions::CompareNumbers first_expression=expr(Variable(Energy)) comparison_sign=">=" second_expression=expr(20 + SkillButton.Variable(Type) * 5)
if NumberObjectVariable object="Hero" variable="Type" comparison_sign="=" value=expr(SkillButton.Variable(Type))
if CompareObjectTimer object="Hero" timer_name="skill" comparison_sign=">=" time_in_seconds=8
do SetNumberVariable variable="Energy" modification_sign="-" value=expr(20 + SkillButton.Variable(Type) * 5)
do ResetObjectTimer object="Hero" timer_name="skill"
do PlaySound audio_file_or_audio_resource_name="assets\\sfx-skill.wav" repeat_the_sound=false volume=62 pitch_speed=1

> @event aiGeneratedEventId="aegis-core-restoration"
> if NumberObjectVariable object="SkillButton" variable="Type" comparison_sign="=" value=1
> do SetNumberVariable variable="CoreHP" modification_sign="+" value=20
> do TextContainerCapability::TextContainerBehavior::SetValue object="StatusText" behavior="Text" modification_sign="=" text="AEGIS SKILL - CORE RESTORED"

>> @event aiGeneratedEventId="cap-core-health"
>> if NumberVariable variable="CoreHP" comparison_sign=">" value=100
>> do SetNumberVariable variable="CoreHP" modification_sign="=" value=100

> @event aiGeneratedEventId="rifle-focus-volley"
> if NumberObjectVariable object="SkillButton" variable="Type" comparison_sign="=" value=2
> do SetNumberObjectVariable object="Enemy" variable="HP" modification_sign="-" value=50
> do TextContainerCapability::TextContainerBehavior::SetValue object="StatusText" behavior="Text" modification_sign="=" text="RIFLE SKILL - FOCUS VOLLEY"

> @event aiGeneratedEventId="shotgun-shockwave"
> if NumberObjectVariable object="SkillButton" variable="Type" comparison_sign="=" value=3
> do SetNumberObjectVariable object="Enemy" variable="HP" modification_sign="-" value=30
> do SetX object="Enemy" modification_sign="+" value=90
> do TextContainerCapability::TextContainerBehavior::SetValue object="StatusText" behavior="Text" modification_sign="=" text="SHOTGUN SKILL - GLOBAL SHOCKWAVE"

> @event aiGeneratedEventId="rocket-barrage"
> if NumberObjectVariable object="SkillButton" variable="Type" comparison_sign="=" value=4
> do SetNumberObjectVariable object="Enemy" variable="HP" modification_sign="-" value=90
> do TextContainerCapability::TextContainerBehavior::SetValue object="StatusText" behavior="Text" modification_sign="=" text="ROCKET SKILL - SKYFALL BARRAGE"

@event aiGeneratedEventId="upgrade-deployed-hero"
if NumberVariable variable="GameState" comparison_sign="<" value=2
if HasAnyTouchOrMouseStarted
if BuiltinCommonInstructions::Once
if IsCursorOnObject object="UpgradeButton" accurate_test_yes_by_default=true
if BuiltinCommonInstructions::CompareNumbers first_expression=expr(Variable(Energy)) comparison_sign=">=" second_expression=expr(10 + UpgradeButton.Variable(Type) * 10)
if NumberObjectVariable object="Hero" variable="Type" comparison_sign="=" value=expr(UpgradeButton.Variable(Type))
do SetNumberVariable variable="Energy" modification_sign="-" value=expr(10 + UpgradeButton.Variable(Type) * 10)
do SetNumberObjectVariable object="Hero" variable="Level" modification_sign="+" value=1
do SetNumberObjectVariable object="Hero" variable="MaxHP" modification_sign="+" value=20
do SetNumberObjectVariable object="Hero" variable="HP" modification_sign="+" value=20
do TextContainerCapability::TextContainerBehavior::SetValue object="StatusText" behavior="Text" modification_sign="=" text=expr("HERO UPGRADED TO LEVEL " + ToString(Hero.Variable(Level)))
do PlaySound audio_file_or_audio_resource_name="assets\\sfx-deploy.wav" repeat_the_sound=false volume=42 pitch_speed=1.4

@event aiGeneratedEventId="core-destroyed"
if NumberVariable variable="GameState" comparison_sign="<" value=2
if NumberVariable variable="CoreHP" comparison_sign="<=" value=0
do SetNumberVariable variable="GameState" modification_sign="=" value=2
do OpacityCapability::OpacityBehavior::SetValue object="EndPanel" behavior="Opacity" modification_sign="=" opacity_0_255=255
do OpacityCapability::OpacityBehavior::SetValue object="EndTitle" behavior="Opacity" modification_sign="=" opacity_0_255=255
do TextContainerCapability::TextContainerBehavior::SetValue object="EndTitle" behavior="Text" modification_sign="=" text="CORE LOST"
do TextContainerCapability::TextContainerBehavior::SetValue object="StatusText" behavior="Text" modification_sign="=" text=expr("DEFENSE FAILED ON WAVE " + ToString(Variable(Wave)))
do PlaySound audio_file_or_audio_resource_name="assets\\sfx-defeat.wav" repeat_the_sound=false volume=76 pitch_speed=1

> @event aiGeneratedEventId="save-defeat-best"
> if BuiltinCommonInstructions::CompareNumbers first_expression=expr(Variable(Score)) comparison_sign=">" second_expression=expr(Variable(BestScore))
> do SetNumberVariable variable="BestScore" modification_sign="=" value=expr(Variable(Score))
> do EcrireFichierExp storage_name="HeroLineDefense" group="BestScore" expression=expr(Variable(BestScore))

@event aiGeneratedEventId="restart-with-enter"
if NumberVariable variable="GameState" comparison_sign=">=" value=2
if KeyFromTextPressed key_to_check="Return"
if BuiltinCommonInstructions::Once
do Scene name_of_the_new_scene="Game" stop_any_other_paused_scenes=true

@event aiGeneratedEventId="restart-with-touch"
if NumberVariable variable="GameState" comparison_sign=">=" value=2
if HasAnyTouchOrMouseStarted
do Scene name_of_the_new_scene="Game" stop_any_other_paused_scenes=true

@end group
