@group "Initialization and HUD" source="" creationTime=0 color=[69,197,255] parameters=[]

@event aiGeneratedEventId="initialize-defense"
if SceneJustBegins
do SetNumberVariable variable="Wave" modification_sign="=" value=0
do SetNumberVariable variable="GameState" modification_sign="=" value=0
do SetNumberVariable variable="ToSpawn" modification_sign="=" value=0
do SetNumberVariable variable="Spawned" modification_sign="=" value=0
do SetNumberVariable variable="NextLane" modification_sign="=" value=1
do SetNumberVariable variable="Energy" modification_sign="=" value=180
do SetNumberVariable variable="Score" modification_sign="=" value=0
do SetNumberVariable variable="SelectedHero" modification_sign="=" value=1
do SetNumberVariable variable="CoreHP" modification_sign="=" value=100
do SetNumberVariable variable="H1Deployed" modification_sign="=" value=0
do SetNumberVariable variable="H2Deployed" modification_sign="=" value=0
do SetNumberVariable variable="H3Deployed" modification_sign="=" value=0
do SetNumberVariable variable="H4Deployed" modification_sign="=" value=0
do ReadNumberFromStorage storage_name="HeroLineDefense" group="BestScore" variable="BestScore"
do ResetTimer timer_name="WaveDelay"
do ResetTimer timer_name="Spawn"
do OpacityCapability::OpacityBehavior::SetValue object="EndPanel" behavior="Opacity" modification_sign="=" opacity_0_255=0
do OpacityCapability::OpacityBehavior::SetValue object="EndTitle" behavior="Opacity" modification_sign="=" opacity_0_255=0
do TextContainerCapability::TextContainerBehavior::SetValue object="StatusText" behavior="Text" modification_sign="=" text="DEPLOY HEROES - WAVE 1 STARTS IN 3"
do TextContainerCapability::TextContainerBehavior::SetValue object="SelectedText" behavior="Text" modification_sign="=" text="SELECTED: AEGIS"

> @event aiGeneratedEventId="initialize-type-one-art"
> if NumberObjectVariable object="HeroCard" variable="Type" comparison_sign="=" value=1
> if NumberObjectVariable object="SkillButton" variable="Type" comparison_sign="=" value=1
> if NumberObjectVariable object="UpgradeButton" variable="Type" comparison_sign="=" value=1
> do AnimatableCapability::AnimatableBehavior::SetIndex object="HeroCard" behavior="Animation" modification_sign="=" animation_index=0
> do AnimatableCapability::AnimatableBehavior::SetIndex object="SkillButton" behavior="Animation" modification_sign="=" animation_index=0
> do AnimatableCapability::AnimatableBehavior::SetIndex object="UpgradeButton" behavior="Animation" modification_sign="=" animation_index=0

> @event aiGeneratedEventId="initialize-type-two-art"
> if NumberObjectVariable object="HeroCard" variable="Type" comparison_sign="=" value=2
> if NumberObjectVariable object="SkillButton" variable="Type" comparison_sign="=" value=2
> if NumberObjectVariable object="UpgradeButton" variable="Type" comparison_sign="=" value=2
> do AnimatableCapability::AnimatableBehavior::SetIndex object="HeroCard" behavior="Animation" modification_sign="=" animation_index=1
> do AnimatableCapability::AnimatableBehavior::SetIndex object="SkillButton" behavior="Animation" modification_sign="=" animation_index=1
> do AnimatableCapability::AnimatableBehavior::SetIndex object="UpgradeButton" behavior="Animation" modification_sign="=" animation_index=1

> @event aiGeneratedEventId="initialize-type-three-art"
> if NumberObjectVariable object="HeroCard" variable="Type" comparison_sign="=" value=3
> if NumberObjectVariable object="SkillButton" variable="Type" comparison_sign="=" value=3
> if NumberObjectVariable object="UpgradeButton" variable="Type" comparison_sign="=" value=3
> do AnimatableCapability::AnimatableBehavior::SetIndex object="HeroCard" behavior="Animation" modification_sign="=" animation_index=2
> do AnimatableCapability::AnimatableBehavior::SetIndex object="SkillButton" behavior="Animation" modification_sign="=" animation_index=2
> do AnimatableCapability::AnimatableBehavior::SetIndex object="UpgradeButton" behavior="Animation" modification_sign="=" animation_index=2

> @event aiGeneratedEventId="initialize-type-four-art"
> if NumberObjectVariable object="HeroCard" variable="Type" comparison_sign="=" value=4
> if NumberObjectVariable object="SkillButton" variable="Type" comparison_sign="=" value=4
> if NumberObjectVariable object="UpgradeButton" variable="Type" comparison_sign="=" value=4
> do AnimatableCapability::AnimatableBehavior::SetIndex object="HeroCard" behavior="Animation" modification_sign="=" animation_index=3
> do AnimatableCapability::AnimatableBehavior::SetIndex object="SkillButton" behavior="Animation" modification_sign="=" animation_index=3
> do AnimatableCapability::AnimatableBehavior::SetIndex object="UpgradeButton" behavior="Animation" modification_sign="=" animation_index=3

@event aiGeneratedEventId="refresh-hud"
if NumberVariable variable="GameState" comparison_sign=">=" value=0
do TextContainerCapability::TextContainerBehavior::SetValue object="WaveText" behavior="Text" modification_sign="=" text=expr("WAVE " + ToString(Variable(Wave)) + " / 10")
do TextContainerCapability::TextContainerBehavior::SetValue object="CoreText" behavior="Text" modification_sign="=" text=expr("CORE " + ToString(Variable(CoreHP)))
do TextContainerCapability::TextContainerBehavior::SetValue object="EnergyText" behavior="Text" modification_sign="=" text=expr("ENERGY " + ToString(Variable(Energy)))
do TextContainerCapability::TextContainerBehavior::SetValue object="ScoreText" behavior="Text" modification_sign="=" text=expr("SCORE " + ToString(Variable(Score)))
do TextContainerCapability::TextContainerBehavior::SetValue object="BestText" behavior="Text" modification_sign="=" text=expr("BEST " + ToString(Variable(BestScore)))

@end group

@group "Selection deployment and lane shifts" source="" creationTime=0 color=[255,196,82] parameters=[]

@event aiGeneratedEventId="select-hero-card"
if NumberVariable variable="GameState" comparison_sign="<" value=2
if HasAnyTouchOrMouseStarted
if BuiltinCommonInstructions::Once
if IsCursorOnObject object="HeroCard" accurate_test_yes_by_default=true
do SetNumberVariable variable="SelectedHero" modification_sign="=" value=expr(HeroCard.Variable(Type))
do SetX object="Selection" modification_sign="=" value=expr(HeroCard.X())
do SetY object="Selection" modification_sign="=" value=expr(HeroCard.Y())
do PlaySound audio_file_or_audio_resource_name="assets\\sfx-deploy.wav" repeat_the_sound=false volume=24 pitch_speed=1.15

> @event aiGeneratedEventId="selected-aegis-label"
> if NumberObjectVariable object="HeroCard" variable="Type" comparison_sign="=" value=1
> do TextContainerCapability::TextContainerBehavior::SetValue object="SelectedText" behavior="Text" modification_sign="=" text="SELECTED: AEGIS / SHIELD"

> @event aiGeneratedEventId="selected-rifle-label"
> if NumberObjectVariable object="HeroCard" variable="Type" comparison_sign="=" value=2
> do TextContainerCapability::TextContainerBehavior::SetValue object="SelectedText" behavior="Text" modification_sign="=" text="SELECTED: RIFLE / FOCUS"

> @event aiGeneratedEventId="selected-shotgun-label"
> if NumberObjectVariable object="HeroCard" variable="Type" comparison_sign="=" value=3
> do TextContainerCapability::TextContainerBehavior::SetValue object="SelectedText" behavior="Text" modification_sign="=" text="SELECTED: SHOTGUN / PUSH"

> @event aiGeneratedEventId="selected-rocket-label"
> if NumberObjectVariable object="HeroCard" variable="Type" comparison_sign="=" value=4
> do TextContainerCapability::TextContainerBehavior::SetValue object="SelectedText" behavior="Text" modification_sign="=" text="SELECTED: ROCKET / BLAST"

@event aiGeneratedEventId="deploy-aegis"
if NumberVariable variable="GameState" comparison_sign="<" value=2
if HasAnyTouchOrMouseStarted
if BuiltinCommonInstructions::Once
if IsCursorOnObject object="LaneTarget" accurate_test_yes_by_default=true
if NumberVariable variable="SelectedHero" comparison_sign="=" value=1
if NumberVariable variable="H1Deployed" comparison_sign="=" value=0
if NumberVariable variable="Energy" comparison_sign=">=" value=30
do Create object_to_create="Hero" x_position=220 y_position=expr(LaneTarget.Y() - 7) layer=""
do SetNumberObjectVariable object="Hero" variable="Type" modification_sign="=" value=1
do SetNumberObjectVariable object="Hero" variable="Lane" modification_sign="=" value=expr(LaneTarget.Variable(Lane))
do SetNumberObjectVariable object="Hero" variable="Level" modification_sign="=" value=1
do SetNumberObjectVariable object="Hero" variable="HP" modification_sign="=" value=170
do SetNumberObjectVariable object="Hero" variable="MaxHP" modification_sign="=" value=170
do AnimatableCapability::AnimatableBehavior::SetIndex object="Hero" behavior="Animation" modification_sign="=" animation_index=0
do ResetObjectTimer object="Hero" timer_name="attack"
do ResetObjectTimer object="Hero" timer_name="move"
do ResetObjectTimer object="Hero" timer_name="skill"
do SetNumberVariable variable="H1Deployed" modification_sign="=" value=1
do SetNumberVariable variable="Energy" modification_sign="-" value=30
do TextContainerCapability::TextContainerBehavior::SetValue object="StatusText" behavior="Text" modification_sign="=" text=expr("AEGIS DEPLOYED TO L" + ToString(LaneTarget.Variable(Lane)))
do PlaySound audio_file_or_audio_resource_name="assets\\sfx-deploy.wav" repeat_the_sound=false volume=46 pitch_speed=0.9

@event aiGeneratedEventId="deploy-rifle"
if NumberVariable variable="GameState" comparison_sign="<" value=2
if HasAnyTouchOrMouseStarted
if BuiltinCommonInstructions::Once
if IsCursorOnObject object="LaneTarget" accurate_test_yes_by_default=true
if NumberVariable variable="SelectedHero" comparison_sign="=" value=2
if NumberVariable variable="H2Deployed" comparison_sign="=" value=0
if NumberVariable variable="Energy" comparison_sign=">=" value=35
do Create object_to_create="Hero" x_position=330 y_position=expr(LaneTarget.Y() - 7) layer=""
do SetNumberObjectVariable object="Hero" variable="Type" modification_sign="=" value=2
do SetNumberObjectVariable object="Hero" variable="Lane" modification_sign="=" value=expr(LaneTarget.Variable(Lane))
do SetNumberObjectVariable object="Hero" variable="Level" modification_sign="=" value=1
do SetNumberObjectVariable object="Hero" variable="HP" modification_sign="=" value=105
do SetNumberObjectVariable object="Hero" variable="MaxHP" modification_sign="=" value=105
do AnimatableCapability::AnimatableBehavior::SetIndex object="Hero" behavior="Animation" modification_sign="=" animation_index=1
do ResetObjectTimer object="Hero" timer_name="attack"
do ResetObjectTimer object="Hero" timer_name="move"
do ResetObjectTimer object="Hero" timer_name="skill"
do SetNumberVariable variable="H2Deployed" modification_sign="=" value=1
do SetNumberVariable variable="Energy" modification_sign="-" value=35
do TextContainerCapability::TextContainerBehavior::SetValue object="StatusText" behavior="Text" modification_sign="=" text=expr("RIFLE DEPLOYED TO L" + ToString(LaneTarget.Variable(Lane)))
do PlaySound audio_file_or_audio_resource_name="assets\\sfx-deploy.wav" repeat_the_sound=false volume=46 pitch_speed=1.05

@event aiGeneratedEventId="deploy-shotgun"
if NumberVariable variable="GameState" comparison_sign="<" value=2
if HasAnyTouchOrMouseStarted
if BuiltinCommonInstructions::Once
if IsCursorOnObject object="LaneTarget" accurate_test_yes_by_default=true
if NumberVariable variable="SelectedHero" comparison_sign="=" value=3
if NumberVariable variable="H3Deployed" comparison_sign="=" value=0
if NumberVariable variable="Energy" comparison_sign=">=" value=40
do Create object_to_create="Hero" x_position=440 y_position=expr(LaneTarget.Y() - 7) layer=""
do SetNumberObjectVariable object="Hero" variable="Type" modification_sign="=" value=3
do SetNumberObjectVariable object="Hero" variable="Lane" modification_sign="=" value=expr(LaneTarget.Variable(Lane))
do SetNumberObjectVariable object="Hero" variable="Level" modification_sign="=" value=1
do SetNumberObjectVariable object="Hero" variable="HP" modification_sign="=" value=130
do SetNumberObjectVariable object="Hero" variable="MaxHP" modification_sign="=" value=130
do AnimatableCapability::AnimatableBehavior::SetIndex object="Hero" behavior="Animation" modification_sign="=" animation_index=2
do ResetObjectTimer object="Hero" timer_name="attack"
do ResetObjectTimer object="Hero" timer_name="move"
do ResetObjectTimer object="Hero" timer_name="skill"
do SetNumberVariable variable="H3Deployed" modification_sign="=" value=1
do SetNumberVariable variable="Energy" modification_sign="-" value=40
do TextContainerCapability::TextContainerBehavior::SetValue object="StatusText" behavior="Text" modification_sign="=" text=expr("SHOTGUN DEPLOYED TO L" + ToString(LaneTarget.Variable(Lane)))
do PlaySound audio_file_or_audio_resource_name="assets\\sfx-deploy.wav" repeat_the_sound=false volume=46 pitch_speed=0.82

@event aiGeneratedEventId="deploy-rocket"
if NumberVariable variable="GameState" comparison_sign="<" value=2
if HasAnyTouchOrMouseStarted
if BuiltinCommonInstructions::Once
if IsCursorOnObject object="LaneTarget" accurate_test_yes_by_default=true
if NumberVariable variable="SelectedHero" comparison_sign="=" value=4
if NumberVariable variable="H4Deployed" comparison_sign="=" value=0
if NumberVariable variable="Energy" comparison_sign=">=" value=50
do Create object_to_create="Hero" x_position=550 y_position=expr(LaneTarget.Y() - 7) layer=""
do SetNumberObjectVariable object="Hero" variable="Type" modification_sign="=" value=4
do SetNumberObjectVariable object="Hero" variable="Lane" modification_sign="=" value=expr(LaneTarget.Variable(Lane))
do SetNumberObjectVariable object="Hero" variable="Level" modification_sign="=" value=1
do SetNumberObjectVariable object="Hero" variable="HP" modification_sign="=" value=100
do SetNumberObjectVariable object="Hero" variable="MaxHP" modification_sign="=" value=100
do AnimatableCapability::AnimatableBehavior::SetIndex object="Hero" behavior="Animation" modification_sign="=" animation_index=3
do ResetObjectTimer object="Hero" timer_name="attack"
do ResetObjectTimer object="Hero" timer_name="move"
do ResetObjectTimer object="Hero" timer_name="skill"
do SetNumberVariable variable="H4Deployed" modification_sign="=" value=1
do SetNumberVariable variable="Energy" modification_sign="-" value=50
do TextContainerCapability::TextContainerBehavior::SetValue object="StatusText" behavior="Text" modification_sign="=" text=expr("ROCKET DEPLOYED TO L" + ToString(LaneTarget.Variable(Lane)))
do PlaySound audio_file_or_audio_resource_name="assets\\sfx-deploy.wav" repeat_the_sound=false volume=46 pitch_speed=0.72

@event aiGeneratedEventId="shift-selected-hero"
if NumberVariable variable="GameState" comparison_sign="<" value=2
if HasAnyTouchOrMouseStarted
if BuiltinCommonInstructions::Once
if IsCursorOnObject object="LaneTarget" accurate_test_yes_by_default=true
if NumberObjectVariable object="Hero" variable="Type" comparison_sign="=" value=expr(Variable(SelectedHero))
if CompareObjectTimer object="Hero" timer_name="move" comparison_sign=">=" time_in_seconds=3
do SetY object="Hero" modification_sign="=" value=expr(LaneTarget.Y() - 7)
do SetNumberObjectVariable object="Hero" variable="Lane" modification_sign="=" value=expr(LaneTarget.Variable(Lane))
do ResetObjectTimer object="Hero" timer_name="move"
do TextContainerCapability::TextContainerBehavior::SetValue object="StatusText" behavior="Text" modification_sign="=" text=expr("HERO SHIFTED TO L" + ToString(LaneTarget.Variable(Lane)) + " - MOVE CD 3S")
do PlaySound audio_file_or_audio_resource_name="assets\\sfx-deploy.wav" repeat_the_sound=false volume=34 pitch_speed=1.25

@end group

@group "Ten wave director" source="" creationTime=0 color=[179,104,255] parameters=[]

@event aiGeneratedEventId="start-next-wave"
if NumberVariable variable="GameState" comparison_sign="=" value=0
if NumberVariable variable="Wave" comparison_sign="<" value=10
if CompareTimer timer_name="WaveDelay" comparison_sign=">=" time_in_seconds=3
do SetNumberVariable variable="GameState" modification_sign="=" value=1
do SetNumberVariable variable="Wave" modification_sign="+" value=1
do SetNumberVariable variable="Spawned" modification_sign="=" value=0
do SetNumberVariable variable="ToSpawn" modification_sign="=" value=expr(3 + Variable(Wave))
do ResetTimer timer_name="Spawn"
do TextContainerCapability::TextContainerBehavior::SetValue object="StatusText" behavior="Text" modification_sign="=" text=expr("WAVE " + ToString(Variable(Wave)) + " INCOMING")

> @event aiGeneratedEventId="boss-wave-count"
> if NumberVariable variable="Wave" comparison_sign="=" value=10
> do SetNumberVariable variable="ToSpawn" modification_sign="=" value=1
> do TextContainerCapability::TextContainerBehavior::SetValue object="StatusText" behavior="Text" modification_sign="=" text="FINAL WAVE - VOID TYRANT"

@event aiGeneratedEventId="spawn-wave-enemy"
if NumberVariable variable="GameState" comparison_sign="=" value=1
if BuiltinCommonInstructions::CompareNumbers first_expression=expr(Variable(Spawned)) comparison_sign="<" second_expression=expr(Variable(ToSpawn))
if CompareTimer timer_name="Spawn" comparison_sign=">=" time_in_seconds=0.75
do Create object_to_create="Enemy" x_position=1110 y_position=expr(134 + (Variable(NextLane) - 1) * 104) layer=""
do SetNumberObjectVariable object="Enemy" variable="Lane" modification_sign="=" value=expr(Variable(NextLane))
do SetNumberObjectVariable object="Enemy" variable="Kind" modification_sign="=" value=1
do SetNumberObjectVariable object="Enemy" variable="HP" modification_sign="=" value=40
do SetNumberObjectVariable object="Enemy" variable="MaxHP" modification_sign="=" value=40
do SetNumberObjectVariable object="Enemy" variable="Speed" modification_sign="=" value=60
do SetNumberObjectVariable object="Enemy" variable="Damage" modification_sign="=" value=8
do SetNumberObjectVariable object="Enemy" variable="Reward" modification_sign="=" value=8
do SetNumberObjectVariable object="Enemy" variable="Blocked" modification_sign="=" value=0
do ResetObjectTimer object="Enemy" timer_name="bite"
do SetNumberVariable variable="Spawned" modification_sign="+" value=1
do SetNumberVariable variable="NextLane" modification_sign="+" value=1
do ResetTimer timer_name="Spawn"

> @event aiGeneratedEventId="scout-waves"
> if NumberVariable variable="Wave" comparison_sign="=" value=1
> or NumberVariable variable="Wave" comparison_sign="=" value=6
> do SetNumberObjectVariable object="Enemy" variable="Kind" modification_sign="=" value=1
> do SetNumberObjectVariable object="Enemy" variable="HP" modification_sign="=" value=expr(36 + Variable(Wave) * 9)
> do SetNumberObjectVariable object="Enemy" variable="MaxHP" modification_sign="=" value=expr(36 + Variable(Wave) * 9)
> do SetNumberObjectVariable object="Enemy" variable="Speed" modification_sign="=" value=expr(60 + Variable(Wave) * 4)
> do SetNumberObjectVariable object="Enemy" variable="Damage" modification_sign="=" value=expr(7 + floor(Variable(Wave) / 3))
> do SetNumberObjectVariable object="Enemy" variable="Reward" modification_sign="=" value=expr(7 + Variable(Wave))
> do AnimatableCapability::AnimatableBehavior::SetIndex object="Enemy" behavior="Animation" modification_sign="=" animation_index=0

> @event aiGeneratedEventId="grunt-waves"
> if NumberVariable variable="Wave" comparison_sign="=" value=2
> or NumberVariable variable="Wave" comparison_sign="=" value=7
> do SetNumberObjectVariable object="Enemy" variable="Kind" modification_sign="=" value=2
> do SetNumberObjectVariable object="Enemy" variable="HP" modification_sign="=" value=expr(58 + Variable(Wave) * 11)
> do SetNumberObjectVariable object="Enemy" variable="MaxHP" modification_sign="=" value=expr(58 + Variable(Wave) * 11)
> do SetNumberObjectVariable object="Enemy" variable="Speed" modification_sign="=" value=expr(48 + Variable(Wave) * 3)
> do SetNumberObjectVariable object="Enemy" variable="Damage" modification_sign="=" value=expr(9 + floor(Variable(Wave) / 3))
> do SetNumberObjectVariable object="Enemy" variable="Reward" modification_sign="=" value=expr(10 + Variable(Wave))
> do AnimatableCapability::AnimatableBehavior::SetIndex object="Enemy" behavior="Animation" modification_sign="=" animation_index=1

> @event aiGeneratedEventId="armored-waves"
> if NumberVariable variable="Wave" comparison_sign="=" value=3
> or NumberVariable variable="Wave" comparison_sign="=" value=8
> do SetNumberObjectVariable object="Enemy" variable="Kind" modification_sign="=" value=3
> do SetNumberObjectVariable object="Enemy" variable="HP" modification_sign="=" value=expr(110 + Variable(Wave) * 16)
> do SetNumberObjectVariable object="Enemy" variable="MaxHP" modification_sign="=" value=expr(110 + Variable(Wave) * 16)
> do SetNumberObjectVariable object="Enemy" variable="Speed" modification_sign="=" value=expr(30 + Variable(Wave) * 2)
> do SetNumberObjectVariable object="Enemy" variable="Damage" modification_sign="=" value=expr(13 + floor(Variable(Wave) / 2))
> do SetNumberObjectVariable object="Enemy" variable="Reward" modification_sign="=" value=expr(16 + Variable(Wave))
> do AnimatableCapability::AnimatableBehavior::SetIndex object="Enemy" behavior="Animation" modification_sign="=" animation_index=2

> @event aiGeneratedEventId="flyer-waves"
> if NumberVariable variable="Wave" comparison_sign="=" value=4
> or NumberVariable variable="Wave" comparison_sign="=" value=9
> do SetNumberObjectVariable object="Enemy" variable="Kind" modification_sign="=" value=4
> do SetNumberObjectVariable object="Enemy" variable="HP" modification_sign="=" value=expr(64 + Variable(Wave) * 10)
> do SetNumberObjectVariable object="Enemy" variable="MaxHP" modification_sign="=" value=expr(64 + Variable(Wave) * 10)
> do SetNumberObjectVariable object="Enemy" variable="Speed" modification_sign="=" value=expr(74 + Variable(Wave) * 3)
> do SetNumberObjectVariable object="Enemy" variable="Damage" modification_sign="=" value=expr(10 + floor(Variable(Wave) / 2))
> do SetNumberObjectVariable object="Enemy" variable="Reward" modification_sign="=" value=expr(14 + Variable(Wave))
> do AnimatableCapability::AnimatableBehavior::SetIndex object="Enemy" behavior="Animation" modification_sign="=" animation_index=3

> @event aiGeneratedEventId="elite-wave"
> if NumberVariable variable="Wave" comparison_sign="=" value=5
> do SetNumberObjectVariable object="Enemy" variable="Kind" modification_sign="=" value=5
> do SetNumberObjectVariable object="Enemy" variable="HP" modification_sign="=" value=220
> do SetNumberObjectVariable object="Enemy" variable="MaxHP" modification_sign="=" value=220
> do SetNumberObjectVariable object="Enemy" variable="Speed" modification_sign="=" value=56
> do SetNumberObjectVariable object="Enemy" variable="Damage" modification_sign="=" value=17
> do SetNumberObjectVariable object="Enemy" variable="Reward" modification_sign="=" value=28
> do AnimatableCapability::AnimatableBehavior::SetIndex object="Enemy" behavior="Animation" modification_sign="=" animation_index=4

> @event aiGeneratedEventId="boss-stats"
> if NumberVariable variable="Wave" comparison_sign="=" value=10
> do SetNumberObjectVariable object="Enemy" variable="Kind" modification_sign="=" value=6
> do SetNumberObjectVariable object="Enemy" variable="HP" modification_sign="=" value=1200
> do SetNumberObjectVariable object="Enemy" variable="MaxHP" modification_sign="=" value=1200
> do SetNumberObjectVariable object="Enemy" variable="Speed" modification_sign="=" value=18
> do SetNumberObjectVariable object="Enemy" variable="Damage" modification_sign="=" value=28
> do SetNumberObjectVariable object="Enemy" variable="Reward" modification_sign="=" value=500
> do AnimatableCapability::AnimatableBehavior::SetIndex object="Enemy" behavior="Animation" modification_sign="=" animation_index=5

@event aiGeneratedEventId="wrap-next-lane"
if NumberVariable variable="NextLane" comparison_sign=">" value=4
do SetNumberVariable variable="NextLane" modification_sign="=" value=1

@event aiGeneratedEventId="normal-wave-cleared"
if NumberVariable variable="GameState" comparison_sign="=" value=1
if NumberVariable variable="Wave" comparison_sign="<" value=10
if BuiltinCommonInstructions::CompareNumbers first_expression=expr(Variable(Spawned)) comparison_sign=">=" second_expression=expr(Variable(ToSpawn))
if SceneInstancesCount object="Enemy" comparison_sign="=" value=0
do SetNumberVariable variable="GameState" modification_sign="=" value=0
do SetNumberVariable variable="Energy" modification_sign="+" value=30
do ResetTimer timer_name="WaveDelay"
do TextContainerCapability::TextContainerBehavior::SetValue object="StatusText" behavior="Text" modification_sign="=" text=expr("WAVE " + ToString(Variable(Wave)) + " CLEARED - +30 ENERGY")

@event aiGeneratedEventId="final-wave-cleared"
if NumberVariable variable="GameState" comparison_sign="=" value=1
if NumberVariable variable="Wave" comparison_sign="=" value=10
if BuiltinCommonInstructions::CompareNumbers first_expression=expr(Variable(Spawned)) comparison_sign=">=" second_expression=expr(Variable(ToSpawn))
if SceneInstancesCount object="Enemy" comparison_sign="=" value=0
do SetNumberVariable variable="GameState" modification_sign="=" value=3
do SetNumberVariable variable="Score" modification_sign="+" value=1000
do OpacityCapability::OpacityBehavior::SetValue object="EndPanel" behavior="Opacity" modification_sign="=" opacity_0_255=255
do OpacityCapability::OpacityBehavior::SetValue object="EndTitle" behavior="Opacity" modification_sign="=" opacity_0_255=255
do TextContainerCapability::TextContainerBehavior::SetValue object="EndTitle" behavior="Text" modification_sign="=" text="BASTION SECURED"
do TextContainerCapability::TextContainerBehavior::SetValue object="StatusText" behavior="Text" modification_sign="=" text="ALL TEN WAVES CLEARED"
do PlaySound audio_file_or_audio_resource_name="assets\\sfx-victory.wav" repeat_the_sound=false volume=76 pitch_speed=1

> @event aiGeneratedEventId="save-victory-best"
> if BuiltinCommonInstructions::CompareNumbers first_expression=expr(Variable(Score)) comparison_sign=">" second_expression=expr(Variable(BestScore))
> do SetNumberVariable variable="BestScore" modification_sign="=" value=expr(Variable(Score))
> do EcrireFichierExp storage_name="HeroLineDefense" group="BestScore" expression=expr(Variable(BestScore))

@end group

@group "Automatic combat" source="" creationTime=0 color=[255,98,151] parameters=[]

@event aiGeneratedEventId="each-hero-auto-attack"
for each Hero
> @event aiGeneratedEventId="aegis-auto-attack"
> if NumberVariable variable="GameState" comparison_sign="=" value=1
> if NumberObjectVariable object="Hero" variable="Type" comparison_sign="=" value=1
> if NumberObjectVariable object="Enemy" variable="Lane" comparison_sign="=" value=expr(Hero.Variable(Lane))
> if CompareObjectTimer object="Hero" timer_name="attack" comparison_sign=">=" time_in_seconds=0.85
> do Create object_to_create="Projectile" x_position=expr(Hero.X() + 72) y_position=expr(Hero.Y() + 39) layer=""
> do SetNumberObjectVariable object="Projectile" variable="Type" modification_sign="=" value=1
> do SetNumberObjectVariable object="Projectile" variable="Lane" modification_sign="=" value=expr(Hero.Variable(Lane))
> do SetNumberObjectVariable object="Projectile" variable="Damage" modification_sign="=" value=expr(14 + Hero.Variable(Level) * 5)
> do AnimatableCapability::AnimatableBehavior::SetIndex object="Projectile" behavior="Animation" modification_sign="=" animation_index=0
> do AddForceXY object="Projectile" speed_on_x_axis_in_pixels_per_second=620 speed_on_y_axis_in_pixels_per_second=0 force_multiplier=1
> do ResetObjectTimer object="Hero" timer_name="attack"
> do PlaySound audio_file_or_audio_resource_name="assets\\sfx-shot.wav" repeat_the_sound=false volume=10 pitch_speed=0.78

> @event aiGeneratedEventId="rifle-auto-attack"
> if NumberVariable variable="GameState" comparison_sign="=" value=1
