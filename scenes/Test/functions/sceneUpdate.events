@group "Animation controls" source="" creationTime=0 color=[255,132,120] parameters=[]
@event aiGeneratedEventId="test-initialize"
if SceneJustBegins
do SetNumberVariable variable="AnimationIndex" modification_sign="=" value=0
do SetNumberVariable variable="Paused" modification_sign="=" value=0
do SetNumberVariable variable="CameraOrbitAngle" modification_sign="=" value=-90
do SetNumberVariable variable="CameraDragStartX" modification_sign="=" value=0
do SetNumberVariable variable="CameraDragStartAngle" modification_sign="=" value=-90
do SetCameraCenterX modification_sign="=" value=640 layer="" camera_number_default_0=0
do SetCameraCenterY modification_sign="=" value=-165 layer="" camera_number_default_0=0
do Scene3D::SetCameraZ modification_sign="=" value=252 layer="" camera_number_default_0=0
do Scene3D::TurnCameraTowardPosition x_position=640 y_position=535 z_position=252 layer="" camera_number_default_0=0 stand_on_y_instead_of_z=false
do AnimatableCapability::AnimatableBehavior::SetIndex object="TwinKunai3D" behavior="Animation" modification_sign="=" animation_index=0
do AnimatableCapability::AnimatableBehavior::SetElapsedTime object="TwinKunai3D" behavior="Animation" modification_sign="=" elapsed_time_in_seconds=0
do AnimatableCapability::AnimatableBehavior::PlayAnimation object="TwinKunai3D" behavior="Animation"
do Scene3D::Base3DBehavior::AttachToModelBone parameter_3d_object="TwinKunaiHairCloth" behavior="Object3D" target_3d_model="TwinKunai3D" bone_name="head"
do Scene3D::Base3DBehavior::SetBoneAttachmentPositionOffset parameter_3d_object="TwinKunaiHairCloth" behavior="Object3D" x_offset=-45 y_offset=-85 z_offset=75
do Scene3D::Base3DBehavior::SetBoneAttachmentRotationOffset parameter_3d_object="TwinKunaiHairCloth" behavior="Object3D" x_rotation_offset=0 y_rotation_offset=0 z_rotation_offset=0
do TextContainerCapability::TextContainerBehavior::SetValue object="PlaybackLabel" behavior="Text" modification_sign="=" text="PLAYING"

@event aiGeneratedEventId="test-next-index"
if KeyFromTextReleased key_to_check="Right"
do SetNumberVariable variable="AnimationIndex" modification_sign="+" value=1

@event aiGeneratedEventId="test-next-wrap"
if NumberVariable variable="AnimationIndex" comparison_sign=">" value=28
do SetNumberVariable variable="AnimationIndex" modification_sign="=" value=0

@event aiGeneratedEventId="test-next-apply"
if KeyFromTextReleased key_to_check="Right"
do AnimatableCapability::AnimatableBehavior::SetIndex object="TwinKunai3D" behavior="Animation" modification_sign="=" animation_index=expr(Variable(AnimationIndex))
do AnimatableCapability::AnimatableBehavior::SetElapsedTime object="TwinKunai3D" behavior="Animation" modification_sign="=" elapsed_time_in_seconds=0
do AnimatableCapability::AnimatableBehavior::PlayAnimation object="TwinKunai3D" behavior="Animation"
do SetNumberVariable variable="Paused" modification_sign="=" value=0
do TextContainerCapability::TextContainerBehavior::SetValue object="PlaybackLabel" behavior="Text" modification_sign="=" text="PLAYING"

@event aiGeneratedEventId="test-previous-index"
if KeyFromTextReleased key_to_check="Left"
do SetNumberVariable variable="AnimationIndex" modification_sign="-" value=1

@event aiGeneratedEventId="test-previous-wrap"
if NumberVariable variable="AnimationIndex" comparison_sign="<" value=0
do SetNumberVariable variable="AnimationIndex" modification_sign="=" value=28

@event aiGeneratedEventId="test-previous-apply"
if KeyFromTextReleased key_to_check="Left"
do AnimatableCapability::AnimatableBehavior::SetIndex object="TwinKunai3D" behavior="Animation" modification_sign="=" animation_index=expr(Variable(AnimationIndex))
do AnimatableCapability::AnimatableBehavior::SetElapsedTime object="TwinKunai3D" behavior="Animation" modification_sign="=" elapsed_time_in_seconds=0
do AnimatableCapability::AnimatableBehavior::PlayAnimation object="TwinKunai3D" behavior="Animation"
do SetNumberVariable variable="Paused" modification_sign="=" value=0
do TextContainerCapability::TextContainerBehavior::SetValue object="PlaybackLabel" behavior="Text" modification_sign="=" text="PLAYING"

@event aiGeneratedEventId="test-home-idle"
if KeyFromTextReleased key_to_check="Home"
do SetNumberVariable variable="AnimationIndex" modification_sign="=" value=0
do AnimatableCapability::AnimatableBehavior::SetIndex object="TwinKunai3D" behavior="Animation" modification_sign="=" animation_index=0
do AnimatableCapability::AnimatableBehavior::SetElapsedTime object="TwinKunai3D" behavior="Animation" modification_sign="=" elapsed_time_in_seconds=0
do AnimatableCapability::AnimatableBehavior::PlayAnimation object="TwinKunai3D" behavior="Animation"
do SetNumberVariable variable="Paused" modification_sign="=" value=0
do TextContainerCapability::TextContainerBehavior::SetValue object="PlaybackLabel" behavior="Text" modification_sign="=" text="PLAYING"

@event aiGeneratedEventId="test-replay"
if KeyFromTextReleased key_to_check="Return"
do AnimatableCapability::AnimatableBehavior::SetElapsedTime object="TwinKunai3D" behavior="Animation" modification_sign="=" elapsed_time_in_seconds=0
do AnimatableCapability::AnimatableBehavior::PlayAnimation object="TwinKunai3D" behavior="Animation"
do SetNumberVariable variable="Paused" modification_sign="=" value=0
do TextContainerCapability::TextContainerBehavior::SetValue object="PlaybackLabel" behavior="Text" modification_sign="=" text="PLAYING"

@event aiGeneratedEventId="test-toggle-pause"
if KeyFromTextReleased key_to_check="p"
do SetNumberVariable variable="Paused" modification_sign="=" value=expr(1 - Variable(Paused))
> @event aiGeneratedEventId="test-pause"
> if NumberVariable variable="Paused" comparison_sign="=" value=1
> do AnimatableCapability::AnimatableBehavior::PauseAnimation object="TwinKunai3D" behavior="Animation"
> do TextContainerCapability::TextContainerBehavior::SetValue object="PlaybackLabel" behavior="Text" modification_sign="=" text="PAUSED"

> @event aiGeneratedEventId="test-resume"
> if NumberVariable variable="Paused" comparison_sign="=" value=0
> do AnimatableCapability::AnimatableBehavior::PlayAnimation object="TwinKunai3D" behavior="Animation"
> do TextContainerCapability::TextContainerBehavior::SetValue object="PlaybackLabel" behavior="Text" modification_sign="=" text="PLAYING"
@end group

@group "Camera orbit controls" source="" creationTime=0 color=[143,108,255] parameters=[]
@event aiGeneratedEventId="test-camera-drag-start"
if MouseButtonFromTextPressed button_to_check="Left"
if BuiltinCommonInstructions::Once
do SetNumberVariable variable="CameraDragStartX" modification_sign="=" value=expr(CursorX("HUD", 0))
do SetNumberVariable variable="CameraDragStartAngle" modification_sign="=" value=expr(Variable(CameraOrbitAngle))

@event aiGeneratedEventId="test-camera-drag-orbit"
if MouseButtonFromTextPressed button_to_check="Left"
do SetNumberVariable variable="CameraOrbitAngle" modification_sign="=" value=expr(Variable(CameraDragStartAngle) + (CursorX("HUD", 0) - Variable(CameraDragStartX)) * 0.35)
do SetCameraCenterX modification_sign="=" value=expr(640 + cos(ToRad(Variable(CameraOrbitAngle))) * 700) layer="" camera_number_default_0=0
do SetCameraCenterY modification_sign="=" value=expr(535 + sin(ToRad(Variable(CameraOrbitAngle))) * 700) layer="" camera_number_default_0=0
do Scene3D::SetCameraZ modification_sign="=" value=252 layer="" camera_number_default_0=0
do Scene3D::TurnCameraTowardPosition x_position=640 y_position=535 z_position=252 layer="" camera_number_default_0=0 stand_on_y_instead_of_z=false
@end group

